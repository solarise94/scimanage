model CrmCustomerApplication {
  id                         String                                 @id @default(cuid())
  departmentSnapshot         String                                 @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  name                       String
  principal                  String?
  email                      String?
  wechat                     String?
  organization               String?
  organizationId             String?
  org                        Organization?                          @relation("CrmApplicationsOrg", fields: [organizationId], references: [id], onDelete: SetNull)
  organizationSiteId         String?
  organizationRawInput       String?
  address                    String?
  miniProgramId              String?
  notes                      String?
  locationLat                Float?
  locationLng                Float?
  locationAddress            String?
  status                     String                                 @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedByUserId          String
  submittedByUser            User                                   @relation("CrmApplicationsSubmitted", fields: [submittedByUserId], references: [id])
  reviewedByUserId           String?
  reviewedByUser             User?                                  @relation("CrmApplicationsReviewed", fields: [reviewedByUserId], references: [id])
  reviewedAt                 DateTime?
  reviewNote                 String?
  createdCrmProfileId        String?
  createdCrmProfile          CrmCustomerProfile?                    @relation("CrmApplicationsCreatedProfile", fields: [createdCrmProfileId], references: [id])
  autoApproved               Boolean                                @default(false)
  autoApprovedAt             DateTime?
  adminReviewStatus          String                                 @default("NONE") // NONE | PENDING | CONFIRMED | REJECTED
  adminReviewedByUserId      String?
  adminReviewedByUser        User?                                  @relation("CrmApplicationsAdminReviewed", fields: [adminReviewedByUserId], references: [id])
  adminReviewedAt            DateTime?
  adminReviewNote            String?
  supervisorReviewStatus     String                                 @default("NONE") // NONE | PENDING | CONFIRMED | REJECTED
  supervisorReviewReason     String? // NORMAL | ORG_CONFLICT | CUSTOMER_CONFLICT | DUPLICATE_OVERRIDE | ORG_REQUEST
  supervisorReviewDetail     String? // JSON
  supervisorReviewedByUserId String?
  supervisorReviewedByUser   User?                                  @relation("CrmApplicationsSupervisorReviewed", fields: [supervisorReviewedByUserId], references: [id])
  supervisorReviewedAt       DateTime?
  supervisorReviewNote       String?
  duplicateCheckStatus       String                                 @default("NONE") // NONE | CLEAN | CANDIDATES_FOUND | OVERRIDDEN_NEW
  duplicateCandidatesJson    String?
  conflictType               String? // ORG_CONFLICT | CUSTOMER_CONFLICT | BOTH
  notifiedSupervisorAt       DateTime?
  supervisorEmailTrackings   CrmApplicationSupervisorNotification[]
  createdAt                  DateTime                               @default(now())
  updatedAt                  DateTime                               @updatedAt

  @@index([submittedByUserId])
  @@index([status])
  @@index([adminReviewStatus])
  @@index([supervisorReviewStatus])
  @@index([supervisorReviewedByUserId])
  @@index([departmentSnapshot])
}

model CustomerRelation {
  id              String             @id @default(cuid())
  // Phase E contract：Customer 锚点 FK 已删除，Profile 为唯一事实源
  fromProfileId   String
  fromProfile     CrmCustomerProfile @relation("RelationsFromProfile", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfileId     String
  toProfile       CrmCustomerProfile @relation("RelationsToProfile", fields: [toProfileId], references: [id], onDelete: Cascade)
  type            String
  strength        String?
  notes           String?
  introducedAt    DateTime?
  createdByUserId String
  createdByUser   User               @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([fromProfileId, toProfileId, type])
  @@index([fromProfileId])
  @@index([toProfileId])
}

model CrmRegionManager {
  id        String                           @id @default(cuid())
  userId    String                           @unique
  user      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId  String?
  region    RepresentativeRegion?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  archived  Boolean                          @default(false)
  createdAt DateTime                         @default(now())
  updatedAt DateTime                         @updatedAt
  reps      CrmRegionManagerRepresentative[]
}

model CrmRegionManagerRepresentative {
  id               String           @id @default(cuid())
  managerId        String
  manager          CrmRegionManager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  representativeId String
  representative   Representative   @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  assignedAt       DateTime         @default(now())

  @@unique([managerId, representativeId])
  @@index([representativeId])
}

model RepresentativeOrganization {
  id                                  String                  @id @default(cuid())
  representativeId                    String
  representative                      Representative          @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  organizationId                      String? // null during new-org request flow
  organization                        Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationSiteId                  String? // null = org-level binding; non-null = site-level binding
  organizationSite                    OrganizationSite?       @relation(fields: [organizationSiteId], references: [id], onDelete: SetNull)
  isPrimary                           Boolean                 @default(false)
  requestedOrganizationName           String?
  requestedOrganizationNormalizedName String?
  organizationReviewTaskId            String?
  organizationReviewTask              OrganizationReviewTask? @relation(fields: [organizationReviewTaskId], references: [id], onDelete: SetNull)
  status                              String                  @default("ACTIVE") // ACTIVE | PENDING | REJECTED | ARCHIVED
  source                              String                  @default("MANUAL") // MANUAL | REP_REQUEST
  requestedByUserId                   String?
  requestedBy                         User?                   @relation("RepOrgRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedByUserId                    String?
  reviewedBy                          User?                   @relation("RepOrgReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt                          DateTime?
  reviewNote                          String?
  createdAt                           DateTime                @default(now())
  updatedAt                           DateTime                @updatedAt

  @@unique([representativeId, requestedOrganizationNormalizedName])
  @@unique([organizationReviewTaskId])
  @@unique([representativeId, organizationSiteId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationSiteId, status])
  @@index([organizationId, organizationSiteId])
  @@index([status])
}

model CrmApplicationSupervisorNotification {
  id            String                 @id @default(cuid())
  applicationId String
  application   CrmCustomerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastEmailedAt DateTime?
  createdAt     DateTime               @default(now())

  @@unique([applicationId, userId])
  @@index([userId])
}

model CrmApplicationSupervisorDigest {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastFingerprint String?
  lastEmailedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RepresentativeRegion {
  id          String                           @id @default(cuid())
  name        String                           @unique
  province    String?
  city        String?
  district    String?
  description String?
  archived    Boolean                          @default(false)
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  reps        RepresentativeRegionAssignment[]
  managers    CrmRegionManager[]
}

model RepresentativeRegionAssignment {
  id               String               @id @default(cuid())
  representativeId String
  representative   Representative       @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  regionId         String
  region           RepresentativeRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  isPrimary        Boolean              @default(false)
  assignedAt       DateTime             @default(now())

  @@unique([representativeId, regionId])
  @@index([regionId])
}

model CrmRepresentativeReportDraft {
  id               String                        @id @default(cuid())
  representativeId String
  representative   Representative                @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  periodType       String // WEEK | DAY
  periodKey        String // e.g. "2026-05-05" (Monday date)
  note             String                        @default("")
  createdByUserId  String
  createdByUser    User                          @relation("ReportDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  updatedByUserId  String?
  updatedByUser    User?                         @relation("ReportDraftUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  lines            CrmRepresentativeReportLine[]

  @@unique([representativeId, periodType, periodKey])
  @@index([periodType, periodKey])
}

model CrmRepresentativeReportLine {
  id            String                       @id @default(cuid())
  reportDraftId String
  reportDraft   CrmRepresentativeReportDraft @relation(fields: [reportDraftId], references: [id], onDelete: Cascade)
  profileId     String?
  profile       CrmCustomerProfile?          @relation("ReportLineProfile", fields: [profileId], references: [id], onDelete: SetNull)
  customerName  String                       @default("")
  organization  String?
  demand        String                       @default("")
  note          String                       @default("")
  sortOrder     Int                          @default(0)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([reportDraftId, sortOrder])
  @@index([profileId])
}

model CrmCustomerStageHistory {
  id            String   @id @default(cuid())
  profileId     String
  ownerUserId   String?
  previousStage String?
  nextStage     String
  changedAt     DateTime @default(now())
  reason        String
  actorUserId   String?
  sourceType    String?
  sourceId      String?
  metadataJson  String?

  @@index([profileId, changedAt])
  @@index([ownerUserId, changedAt])
  @@index([nextStage, changedAt])
  @@index([sourceType, sourceId])
  @@map("crm_customer_stage_history")
}

model CrmCustomerAssignmentLog {
  id              String             @id @default(cuid())
  department        String    @default("FIELD_SALES")
  targetDepartment  String?
  profileId       String
  profile         CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromOwnerUserId String?
  fromOwnerUser   User?              @relation("AssignmentFromUser", fields: [fromOwnerUserId], references: [id], onDelete: SetNull)
  toOwnerUserId   String?
  toOwnerUser     User?              @relation("AssignmentToUser", fields: [toOwnerUserId], references: [id], onDelete: SetNull)
  action          String // CLAIM | TRANSFER | MARK_CANDIDATE | RELEASE | SHARE_TO_POOL | REVOKE_POOL_SHARE（历史值 ASSIGN | RECALL | REMIND 保留兼容读取）
  reason          String?
  createdByUserId String
  createdByUser   User               @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@index([profileId])
  @@index([createdAt])
}

/// Agent 发票登记的单文件私有 staging（非批次模型）。
/// storageKey 相对 staging 根目录；文件不得放入 public/。
model AgentInvoiceStagingFile {
  id                         String   @id @default(cuid())
  createdById                String
  agentRunId                 String?
  originalFileName           String
  storageKey                 String   @unique
  mimeType                   String
  fileSize                   Int
  sha256                     String
  status                     String   @default("UPLOADED") // UPLOADED | ANALYZING | ANALYZED | REGISTERED | SKIPPED | EXPIRED
  extractedJson              String?
  ocrRawText                 String?
  ocrWarningsJson            String?
  version                    Int      @default(1)
  registeredInvoiceRequestId String?
  registeredDocumentId       String?
  expiresAt                  DateTime
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([createdById, status, createdAt])
  @@index([sha256])
  @@index([expiresAt])
}

/// Agent 订单/银行流水导入的单文件私有 staging（非批次模型）。
/// 见 docs/agent-sequential-order-import-upgrade-design-2026-07-21.md §4.1。
/// storageKey 相对私有根目录；文件不得放入 public/。importKind 区分 ORDER | BANK_FLOW。
model AgentImportStagingFile {
  id             String    @id @default(cuid())
  ownerUserId    String
  agentRunId     String?
  storageKey     String    @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  importKind     String // ORDER | BANK_FLOW
  parserKey      String? // ORDER_GENERIC | PINGOODMICE | BANK_FLOW
  status         String    @default("UPLOADED") // UPLOADED | ANALYZING | ANALYZED | FAILED | EXPIRED
  sessionId      String?
  version        Int       @default(1)
  leaseStartedAt DateTime?
  /// ANALYZING worker fencing：claim/heartbeat/写回必须匹配；租约回收或终态时清 null。
  leaseOwner     String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ownerUserId, sha256, importKind])
  @@index([ownerUserId, agentRunId, status])
  @@index([expiresAt])
}

/// Agent 通用附件私有 staging（docs/agent-attachment-routing-design-2026-07-24.md §5）。
/// 与发票/导入 staging 并列，承载"客户截图/需求 PDF/报价单"等一般资料的多目标路由。
/// storageKey 相对 AGENT_ATTACHMENT_STAGING_DIR；文件不得放入 public/。
model AgentAttachmentStagingFile {
  id               String   @id @default(cuid())
  ownerUserId      String
  agentRunId       String?
  chatSessionId    String?
  storageKey       String   @unique
  originalName     String
  mimeType         String // 服务端 magic 识别后的 MIME
  sizeBytes        Int
  sha256           String
  status           String   @default("UPLOADED") // UPLOADED | ANALYZING | ANALYZED | FAILED | EXPIRED
  analysisJson     String? // <= 32 KiB；不存模型 chain-of-thought
  warningsJson     String?
  analysisAttempts Int      @default(0) // 最大 3 次实际 provider 调用
  version          Int      @default(1)
  leaseOwner       String?
  leaseStartedAt   DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messageLinks AgentChatAttachmentLink[]
  routes       AgentAttachmentRoute[]

  @@index([ownerUserId, agentRunId, status])
  @@index([chatSessionId, createdAt])
  @@index([ownerUserId, sha256])
  @@index([expiresAt])
}

/// 用户消息 ↔ 通用附件 staging 的结构化关联（事实源；metadataJson 仅存 attachmentCount 冗余）。
model AgentChatAttachmentLink {
  id        String                     @id @default(cuid())
  messageId String
  message   AgentChatMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  stagingId String
  staging   AgentAttachmentStagingFile @relation(fields: [stagingId], references: [id], onDelete: Cascade)
  sortOrder Int
  createdAt DateTime                   @default(now())

  @@unique([messageId, stagingId])
  @@index([stagingId])
}

/// 通用附件到业务目标的路由记录：幂等、执行状态与目标引用（docs §4.1/§5.1）。
/// 一个源附件可路由到多个业务对象，因此 staging 本体不用单一 ROUTED 终态。
model AgentAttachmentRoute {
  id                      String                     @id @default(cuid())
  stagingId               String
  staging                 AgentAttachmentStagingFile @relation(fields: [stagingId], references: [id], onDelete: Cascade)
  sourceProposalId        String? // confirm 路由的 proposal 审计关联
  proposalItemKey         String? @unique // PROJECT_NOTE:{proposalId}:{stagingId}
  activeRouteKey          String? @unique // safe 路由互斥键；终态失效时清空（如 INVOICE_STAGING:{userId}:{stagingId}）
  targetType              String // INVOICE_STAGING | PROJECT_NOTE
  targetId                String? // execute 后填目标 ID
  state                   String   @default("PENDING") // PENDING | PROCESSING | PROMOTED | FAILED | STALE
  expectedSha256          String
  expectedVersion         Int
  processingProposalId    String?
  destinationAttachmentId String? @unique
  error                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([sourceProposalId, stagingId])
  @@index([stagingId, targetType])
  @@index([state, updatedAt])
}

/// 受控任务工作空间：保存私有输入、manifest、中间结果和输出引用。
/// 见设计文档 §3.1。不提供 shell / venv / 任意命令执行。
model AgentTaskWorkspace {
  id              String   @id @default(cuid())
  ownerUserId     String
  kind            String // ORDER_IMPORT | INVOICE_INGEST | BANK_FLOW
  storagePrefix   String
  manifestJson    String?
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED | EXPIRED | CANCELLED
  version         Int      @default(1)
  /// EXECUTING 态绑定的 proposalId（fencing token，实体列；CAS where 过滤用）
  boundProposalId String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerUserId, kind, status])
  @@index([expiresAt])
}

/// 后台 Job：独立于聊天 session 和 HTTP 请求的长任务调度信封。
/// 见设计文档 §3.2。ownerUserId 是所有权主权；AgentRun 只负责展示与接续。
model AgentBackgroundJob {
  id                String    @id @default(cuid())
  ownerUserId       String
  workspaceId       String?
  kind              String // ORDER_IMPORT | INVOICE_INGEST | BANK_FLOW_MATCH
  subjectType       String? // 领域主队列类型，如 OrderImportSession
  subjectId         String?
  status            String    @default("QUEUED") // QUEUED | RUNNING | WAITING_CONFIRMATION | PAUSED | COMPLETED | COMPLETED_WITH_ERRORS | CANCEL_REQUESTED | CANCELLED | FAILED | EXPIRED
  cursor            String?
  version           Int       @default(1)
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  initialAgentRunId String?
  currentAgentRunId String?
  cancelRequestedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items AgentBackgroundJobItem[]

  @@index([ownerUserId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([currentAgentRunId])
}

/// 后台 Job 的单项：对应一个 staging 文件/行的 safe 处理单元。
/// 只保存调度状态，不复制订单行、发票或 OCR 的业务事实。
model AgentBackgroundJobItem {
  id                String    @id @default(cuid())
  jobId             String
  sequenceNo        Int
  stagingType       String // ORDER | INVOICE | BANK_FLOW
  stagingId         String
  status            String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | SKIPPED
  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime?
  proposalId        String?
  resultSummaryJson String?
  errorCode         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  job AgentBackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequenceNo])
  @@index([jobId, status])
  @@index([status, nextAttemptAt])
}

model AgentActionLog {
  id         String   @id @default(cuid())
  userId     String
  agentRunId String?
  actionKey  String
  riskLevel  String
  status     String
  inputJson  String
  outputJson String?
  error      String?
  proposalId String?
  targetType String?
  targetId   String?
  /// Phase A public-tool 运行时归因：经 public facade 调度时记录对应的 publicToolKey。
  /// 旧 action 直调为 null；业务审计归因不变（actionKey 仍是权威 internal action）。
  publicToolKey String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actionKey, createdAt])
  @@index([proposalId])
  @@index([agentRunId])
}

/// 技术负责人治理任务（Phase E，修正 5）。
/// 覆盖 Order 与 Project：历史 techSupport/owner 缺失或歧义的资源进入此队列，
/// 由 ADMIN 在 UI 指派 technicalOwnerUserId 前，Agent 写一律 fail-closed。
/// @@unique([resourceType, resourceId]) 防同一资源重复建任务。
model TechnicalOwnerGovernanceTask {
  id                 String   @id @default(cuid())
  /// ORDER | PROJECT
  resourceType       String
  resourceId         String
  /// 历史展示名（Project.techSupport 字符串；Order 无历史字段故为 null）。
  legacyDisplayName  String?
  /// PENDING | RESOLVED_AUTO | RESOLVED_MANUAL
  status             String   @default("PENDING")
  /// 自动回填或手工指派的 user id（resolvedUser 反向关系）。
  resolvedUserId     String?
  resolvedUser       User?    @relation("GovernanceResolvedBy", fields: [resolvedUserId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?
  /// 治理原因：EMPTY（无历史名）/ AMBIGUOUS（多名匹配）/ NO_INTERNAL_MATCH（匹配到非员工）
  reason             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([resourceType, resourceId])
  @@index([resourceType, status])
  @@index([status])
}

/// 订单草稿（Phase C，修正 6：关系表替代 JSON）。
/// server-owned、可审计、可过期回收。prepare_order 创建，GenUI PATCH 修改行，
/// propose_order 经 AgentProposal→confirm 消费（CONSUMED）。
model OrderDraft {
  id               String   @id @default(cuid())
  /// 绑定的合格 actor（Agent 创建订单时同事务绑为 technicalOwner）。
  ownerUserId      String
  ownerUser        User     @relation("OrderDraftsOwnedBy", fields: [ownerUserId], references: [id], onDelete: Cascade)
  agentRunId       String?
  customerProfileId String?
  customerProfile  CrmCustomerProfile? @relation("ProfileOrderDrafts", fields: [customerProfileId], references: [id], onDelete: SetNull)
  /// 乐观锁版本号；GenUI PATCH 必须匹配 expectedVersion。
  version          Int      @default(1)
  /// DRAFT | CONSUMED | EXPIRED
  status           String   @default("DRAFT")
  /// 服务端确定性生成的标题快照（单行=产品名；多行=首项 等 N 项）。
  titleSnapshot    String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lines            OrderDraftLine[]

  @@index([ownerUserId, status])
  @@index([status, expiresAt])
  @@index([agentRunId])
}

/// 订单草稿行（Phase C，修正 6）。
/// 存服务端解析后的稳定 productKey（catalog/SKU）+ 展示快照，不存短期 productOptionRef。
model OrderDraftLine {
  id                       String   @id @default(cuid())
  orderDraftId             String
  orderDraft               OrderDraft @relation(fields: [orderDraftId], references: [id], onDelete: Cascade)
  sortOrder                Int      @default(0)
  /// 服务端解析后的稳定产品 key（catalog/SKU；后续接产品—货号明细表只换 provider）。
  productKey               String
  /// Phase 1：真实 ProductSku id（active+sellable）。confirm 时原子写入 OrderLine 绑定，
  /// 避免"草稿已选产品，正式订单只留下名称"的降级（设计文档 §5.3）。
  /// legacy 草稿（仅 productKey）兼容期允许为 null，但新草稿必须经 productSkuId。
  productSkuId             String?
  /// 成交时编号快照（与 OrderLine 对齐）。
  productCodeSnapshot      String?
  skuCodeSnapshot          String?
  /// 展示快照（GenUI 卡片用；不作为持久业务事实）。
  productDisplayNameSnapshot String?
  /// 项目类型 key（不接受自由文本）。
  projectTypeKey           String
  quantity                 Int
  /// 单价（分；服务端以分保存并重算总额）。
  unitPriceCents           Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([orderDraftId, sortOrder])
}

model AgentProposal {
  id                   String    @id @default(cuid())
  userId               String
  agentRunId           String?
  actionKey            String
  title                String
  summary              String
  riskLevel            String
  inputJson            String
  resultJson           String?
  error                String?
  status               String    @default("PENDING")
  targetType           String?
  targetId             String?
  /// Phase A public-tool 审计归因：经 public facade 创建 proposal 时持久化对应的 publicToolKey。
  /// confirm/reject 复原到 invocation，使终态 ActionLog 可追溯模型实际调用的 public tool。
  /// 旧 proposal / 直调 internal action 为 null。
  publicToolKey       String?
  /// 服务端生成的结构化展示快照（JSON）。卡片组件优先读取此字段，不再从 summary 正则刮取实体名。
  /// 由 buildProposal() 在解析和验证后写入；旧数据为 null，卡片回退到正则匹配。
  displayPropsJson     String?
  /// 串行化活跃键：serialByUser action 在 PENDING/PROCESSING 时写入 `${userId}::${actionKey}`，
  /// 终态（CONFIRMED/FAILED/REJECTED）清为 null。唯一约束保证并发 check-and-create 原子互斥。
  serialActiveKey      String?   @unique
  /// PROCESSING 租约令牌：claim 时写入；终态/超时回收时清 null。
  /// 旧 worker 写终态必须匹配该令牌，回收后即失去提交资格。
  processingLeaseToken String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  decidedAt            DateTime?

  @@index([userId, status, createdAt])
  @@index([actionKey, createdAt])
  @@index([agentRunId, createdAt])
}

/// P1-3 allowProposal 可信前端事件（docs/agent-public-surface-cleanup-plan-2026-07-26.md §六 P1-3）。
/// 模型驱动的 proposal 创建（channel="agent"）必须先消费一个由浏览器 UI 经 NextAuth
/// 颁发的事件，闭合「模型话术触发 propose ≠ 用户明确同意」语义漏洞。
/// 一次性消费：consumeConfirmationEventForProposal 在 proposal 同事务内原子置 consumedAt，
/// count===0 视为无效（已消费 / 跨 run / targetIntent 不匹配）。幂等键防 UI 重放重复颁发。
model AgentUserConfirmationEvent {
  id             String     @id @default(cuid())
  actorUserId    String
  agentRunId     String
  /// 目标 intent：confirm actionKey（如 "contracts.generate"）或 draft 绑定键。
  targetIntent   String
  /// 动作类型；当前仅 create_proposal。预留枚举扩展（如 confirm_draft）。
  action         String     @default("create_proposal")
  /// UI 颁发幂等键：同 actor+key 重复颁发返回既有未消费事件；已消费再颁发 → 409。
  idempotencyKey String     @unique
  /// 一次性消费时间戳；null = 未消费。proposal 创建事务内置非 null。
  consumedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([actorUserId, agentRunId, consumedAt])
}

model AgentRun {
  id         String   @id @default(cuid())
  userId     String
  role       String
  name       String?
  email      String?
  status     String   @default("ACTIVE")
  source     String   @default("CHAT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, lastUsedAt])
}

model AgentChatSession {
  id             String             @id @default(cuid())
  userId         String
  agentRunId     String?
  title          String?
  status         String             @default("ACTIVE")
  source         String             @default("CHAT")
  summary        String?
  compactSummary String?
  metadataJson   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lastMessageAt  DateTime           @default(now())
  messages       AgentChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([agentRunId])
  @@index([status, lastMessageAt])
}

model AgentChatMessage {
  id             String           @id @default(cuid())
  sessionId      String
  session        AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentRunId     String?
  userId         String
  role           String
  content        String
  state          String           @default("done")
  timelineJson   String?
  tokenUsageJson String?
  metadataJson   String?
  createdAt      DateTime         @default(now())
  attachmentLinks AgentChatAttachmentLink[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([agentRunId, createdAt])
}

model AgentMemory {
  id              String    @id @default(cuid())
  userId          String
  scope           String    @default("USER")
  kind            String
  content         String
  confidence      Float     @default(0.5)
  source          String    @default("AGENT")
  sourceMessageId String?
  status          String    @default("ACTIVE")
  metadataJson    String?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  // 向量召回（梦境记忆 D1）：bge-m3 1024 维 Float32 LE 压缩；null=未编码。
  embeddingBytes  Bytes?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, kind, status])
  @@index([expiresAt])
  @@index([lastUsedAt])
}

// 梦境记忆 D1：实体级（项目/客户）热记忆，夜间整理产出。
// 每条 (userId, entityType, entityId) 唯一；summary/embedding 是 dream consolidation 的产物。
// status 生命周期：ACTIVE（当前活跃）→ STALE（久未活跃）→ ARCHIVED（不再注入 prompt）。
model AgentEntityMemory {
  id             String    @id @default(cuid())
  userId         String
  entityType     String // "project" | "customer"
  entityId       String
  name           String // 项目名/客户名快照
  summary        String // 一句话活跃摘要（中文，≤120字）
  activityScore  Float     @default(0)
  lastActiveAt   DateTime?
  // bge-m3 1024 维 Float32 LE 压缩；null=尚未编码（向量服务不可用时的降级产物）。
  embeddingBytes Bytes?
  status         String    @default("ACTIVE") // ACTIVE | STALE | ARCHIVED
  metadataJson   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId, status, activityScore])
}

model AgentProactiveTask {
  id             String    @id @default(cuid())
  userId         String
  agentRunId     String?
  sessionId      String?
  kind           String
  title          String
  payloadJson    String
  status         String    @default("PENDING")
  triggerAt      DateTime
  notificationId String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  decidedAt      DateTime?

  @@index([userId, status, triggerAt])
  @@index([agentRunId])
  @@index([sessionId])
}

// 合同附件（合同台账 AQ 列）：与 InvoiceDocument 并行，构成"合同(非必需) + 发票"双附件
model ContractAttachment {
  id                 String            @id @default(cuid())
  projectId          String? // 改：String → String?（OQ-1：standalone 订单也能生成合同）
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderId            String?
  kind               String            @default("CONTRACT") // CONTRACT | DELIVERY_NOTE | OTHER
  fileName           String // 台账里只有文件名
  fileUrl            String? // 后续上传真实文件后填
  fileSize           Int?
  mimeType           String?
  source             String            @default("IMPORT") // IMPORT | UPLOAD | GENERATED
  uploadedById       String?
  uploadedBy         User?             @relation("ContractAttachmentsUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contractDocumentId String?
  contractDocument   ContractDocument? @relation(fields: [contractDocumentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([orderId])
  @@index([contractDocumentId])
}

// 代表提成档位配置（P3 期，ADMIN 维护）
model RepresentativeCommissionTier {
  id                    String         @id @default(cuid())
  representativeId      String
  representative        Representative @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  thresholdCents        Int // 超过此金额触发更高档
  baseRateBps           Int // 基础提成万分点（200=2%）
  bonusRateBps          Int // 超额档提成万分点
  advanceReceiptRateBps Int // 预存款到账提成（2%=200）
  advanceUsageBonusBps  Int // 预存款使用当月季度奖励加成（3%=300）
  createdAt             DateTime       @default(now())

  @@index([representativeId])
}

// 提成打款记录（P3 期；P1 导入落历史 W/X 快照）
model FinanceCommission {
  id               String         @id @default(cuid())
  departmentSnapshot String       @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  representativeId String
  representative   Representative @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  period           String // "2026-Q1" / "2026-03"
  basisAmountCents Int // 计提基数
  rateBps          Int
  amountCents      Int // 实际提成
  kind             String // ORDER | ADVANCE_RECEIPT | ADVANCE_USAGE | QUARTERLY_BONUS
  status           String         @default("ACCRUED") // ACCRUED | PAID
  paidAt           DateTime?
  note             String?
  createdById      String
  createdBy        User           @relation("FinanceCommissionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([representativeId, period])
  @@index([orderId])
  @@index([projectId])
  @@index([departmentSnapshot])
}

// ─── Customer Merge Audit ──────────────────────────────────────

model CustomerMergeLog {
  id                        String                 @id @default(cuid())
  // Phase E contract：Customer 锚点列已删除，Profile 为唯一事实源
  sourceProfileId           String
  sourceProfile             CrmCustomerProfile     @relation("MergeLogSourceProfile", fields: [sourceProfileId], references: [id], onDelete: Restrict)
  targetProfileId           String
  targetProfile             CrmCustomerProfile     @relation("MergeLogTargetProfile", fields: [targetProfileId], references: [id], onDelete: Restrict)
  migratedCountsJson        String // { projects: N, orders: N, ... }
  migratedIdsJson           String // { projects: [...], orders: [...], ... }
  sourceSnapshotJson        String // 合并前 source 客户/Profile 快照（兼容旧 Customer 形状）
  targetSnapshotJson        String // 合并前 target 客户/Profile 快照
  // P0 修复：Profile 权威快照（docs/customer-name-alias-merge-dedup-fix-2026-07-13.md §5）
  // Customer 快照是迁移前旧字段，可能与合并时 Profile 权威值不同；撤销时用新快照恢复 Profile，
  // 旧日志字段为 null 时沿用旧 Customer 快照恢复逻辑，保证历史兼容。
  sourceProfileSnapshotJson String?
  targetProfileSnapshotJson String?
  fieldResolutionJson       String? // 预留/legacy 字段，当前未写入；不用于 Profile 快照或 alias 迁移清单
  profileResolution         String? // KEEP_TARGET | KEEP_SOURCE | ARCHIVED
  orgResolution             String? // KEEP_TARGET_ORG | KEEP_SOURCE_ORG
  orgRebindCountsJson       String? // 机构重绑定计数
  orgRebindIdsJson          String? // 机构重绑定 ID 列表（用于回滚）
  operatorId                String
  operator                  User                   @relation("MergeLogsOperated", fields: [operatorId], references: [id], onDelete: Restrict)
  reversedAt                DateTime?
  reversedById              String?
  reversedBy                User?                  @relation("MergeLogsReversed", fields: [reversedById], references: [id], onDelete: SetNull)
  reverseReason             String?
  createdAt                 DateTime               @default(now())
  mergeTasks                CustomerMergeTask[]
  // 本次合并在 target 新建的姓名变体记录（CrmCustomerNameAlias），用于精确撤销
  nameAliases               CrmCustomerNameAlias[]

  @@index([sourceProfileId])
  @@index([targetProfileId])
  @@index([operatorId])
  @@index([createdAt])
}

/// 旧 /api/customers/** 兼容转发层审计日志（CrmCustomerProfile 主表化迁移）。
/// 仅记录旧 API route 的调用，用于 Phase 3/4 的 burn-down；
/// 它【记录不到】prisma.customer.findMany 这类内部直接 ORM 读取——那靠静态扫描兜底。
model CustomerApiAuditLog {
  id            String   @id @default(cuid())
  path          String
  method        String
  callerUserId  String?
  profileId     String? // Phase C 扩表：Profile 快照，无 FK（历史调用可能查的是迁移前旧锚点 ID）
  fieldsTouched String? // JSON string: ["name","organizationId"]
  forwardedTo   String?
  statusCode    Int?
  referer       String? // 请求 Referer header（页面来源溯源）
  queryShape    String? // 只记 query key 名（白名单），不记值，如 "search,pageSize"
  userAgent     String? // 请求 User-Agent header
  uiCaller      String? // 前端 x-customer-api-caller header，如 crm-customers-org-filter
  createdAt     DateTime @default(now())

  @@index([path, method])
  @@index([profileId])
  @@index([createdAt])
}

model CustomerMergeTask {
  id               String             @id @default(cuid())
  // Phase E contract：Customer 锚点列已删除，任务对主键为 profileIdA/B
  profileIdA       String
  profileA         CrmCustomerProfile @relation("MergeTasksAsProfileA", fields: [profileIdA], references: [id], onDelete: Restrict)
  profileIdB       String
  profileB         CrmCustomerProfile @relation("MergeTasksAsProfileB", fields: [profileIdB], references: [id], onDelete: Restrict)
  matchTier        String // EXACT | HIGH | MEDIUM
  matchScore       Float
  matchReasonsJson String // ["name+org exact", "miniProgramId match"]
  fieldDiffJson    String // { name: { a, b }, organization: { a, b }, ... }
  status           String             @default("PENDING") // PENDING | PROCESSING | MERGED | IGNORED | SUPERSEDED | STALE
  scannedById      String?
  scannedBy        User?              @relation("MergeTasksScanned", fields: [scannedById], references: [id], onDelete: SetNull)
  scannedAt        DateTime?
  resolvedById     String?
  resolvedBy       User?              @relation("MergeTasksResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolutionNote   String?
  mergeLogId       String?
  mergeLog         CustomerMergeLog?  @relation(fields: [mergeLogId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([profileIdA, profileIdB])
  @@index([status])
  @@index([matchTier])
  @@index([profileIdA])
  @@index([profileIdB])
  @@index([scannedById])
  @@index([resolvedById])
}

// 无机构客户绑定治理任务（需求 1）。
// Phase E contract：profileId 必填唯一键；Customer 锚点列已删除。
model CustomerOrgBindingTask {
  id                      String             @id @default(cuid())
  profileId               String             @unique
  profile                 CrmCustomerProfile @relation("OrgBindingTasksProfile", fields: [profileId], references: [id], onDelete: Cascade)
  // 脏数据快照（扫描时刻）
  customerName            String
  organizationText        String? // 客户的 organization 文本（可能为 null = 完全无机构）
  organizationRawInput    String? // 用户的原始输入文本
  // 建议匹配（扫描时自动跑一次 resolveOrganization）
  suggestedOrganizationId String?
  suggestedOrg            Organization?      @relation("OrgBindingSuggestedOrg", fields: [suggestedOrganizationId], references: [id], onDelete: SetNull)
  suggestedSiteId         String?
  suggestedSite           OrganizationSite?  @relation("OrgBindingSuggestedSite", fields: [suggestedSiteId], references: [id], onDelete: SetNull)
  matchConfidence         String? // EXACT | CANDIDATE | UNMATCHED
  matchReasonsJson        String?
  // 解析结果
  status                  String             @default("PENDING") // PENDING | PROCESSING | RESOLVED | IGNORED
  resolvedOrganizationId  String?
  resolvedOrg             Organization?      @relation("OrgBindingResolvedOrg", fields: [resolvedOrganizationId], references: [id], onDelete: SetNull)
  resolvedSiteId          String?
  resolvedSite            OrganizationSite?  @relation("OrgBindingResolvedSite", fields: [resolvedSiteId], references: [id], onDelete: SetNull)
  resolvedById            String?
  resolvedBy              User?              @relation("OrgBindingResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt              DateTime?
  resolutionNote          String?
  scannedById             String?
  scannedBy               User?              @relation("OrgBindingScannedBy", fields: [scannedById], references: [id], onDelete: SetNull)
  scannedAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status])
  @@index([suggestedOrganizationId])
  @@index([resolvedOrganizationId])
}

// 客户机构文本漂移治理任务（M1b：organizationId 有值但 organization 文本与绑定机构不一致）
model CustomerOrgTextDriftTask {
  id        String             @id @default(cuid())
  profileId String             @unique
  profile   CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  customerNameSnapshot String?
  customerCodeSnapshot String?

  organizationIdSnapshot       String
  organizationSiteIdSnapshot   String?
  organizationTextSnapshot     String?
  organizationRawInputSnapshot String?
  boundOrgNameSnapshot         String
  boundOrgCodeSnapshot         String?

  mismatchKind String // TEXT_DRIFT | SITE_OR_ROOM_IN_ORG_TEXT | INVALID_SITE
  reasonJson   String?

  status                 String    @default("PENDING") // PENDING | RESOLVED | IGNORED
  resolvedAction         String? // CANONICALIZED | REBOUND_ORG | ASSIGNED_SITE | IGNORED | ALREADY_FIXED
  resolvedOrganizationId String?
  resolvedSiteId         String?
  resolvedById           String?
  resolvedBy             User?     @relation("OrgTextDriftResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt             DateTime?
  resolutionNote         String?

  scannedById String?
  scannedBy   User?     @relation("OrgTextDriftScannedBy", fields: [scannedById], references: [id], onDelete: SetNull)
  scannedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([mismatchKind])
  @@index([organizationIdSnapshot])
}

// ===== 合同模板与出具 =====

// 合同模板（ADMIN 维护，固定变量填充）
model ContractTemplate {
  id                String   @id @default(cuid())
  name              String // 模板名称，如"标准测序服务合同"
  category          String // 合同类型，如 SEQUENCING / EQUIPMENT / NDA / OTHER
  description       String?
  // 模板文件存储
  fileUrl           String // 相对路径，如 /uploads/contract-templates/{id}/template.docx
  fileName          String // 原始文件名
  fileSize          Int?
  // 变量校验快照（上传时扫描出的 {xxx} 列表，JSON 字符串）
  detectedVariables String? // JSON: ["sellerName","buyerName","totalAmount",...]
  // 分类默认标记（同 category 下只能有一个 isDefault=true）
  isDefault         Boolean  @default(false)
  archived          Boolean  @default(false)
  // 审计
  createdById       String
  createdBy         User     @relation("ContractTemplatesCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById       String?
  updatedBy         User?    @relation("ContractTemplatesUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents ContractDocument[]

  @@index([category, archived, isDefault])
  @@index([archived])
}

// 合同业务主体（类比 ExternalOrderInvoiceRequest）
model ContractDocument {
  id                        String            @id @default(cuid())
  departmentSnapshot        String            @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  // 模板关联 + 快照
  templateId                String?
  template                  ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  snapshotTemplateUrl       String? // 生成时复制的模板快照路径
  // 合同编号
  contractNo                String            @unique
  // 卖方快照（从 BillingProfile snapshot）
  sellerName                String
  sellerTaxId               String?
  sellerBankName            String?
  sellerBankAccount         String?
  sellerAddress             String?
  sellerPhone               String?
  sellerLegalRepresentative String? // 法定代表人/委托代理人
  // 买方快照（Customer/Org 取值 + 可手填）
  buyerName                 String
  buyerOrgName              String
  buyerTaxId                String?
  buyerAddress              String?
  buyerPhone                String?
  buyerEmail                String?
  // 合同金额（财务口径整数分，对齐发票）
  totalAmount               Int               @default(0) // 单位：分（元×100）
  // 合同明细（JSON 字符串）
  itemsJson                 String? // JSON: [{itemName, spec, quantity, unitPrice(分), amount(分), unit}]
  // 备注
  remark                    String?
  // 状态
  status                    String            @default("GENERATED") // GENERATED
  // 审计
  createdById               String
  createdBy                 User              @relation("ContractDocumentsCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  // Agent 生成意图（一对一；手动 UI 生成时为 null）
  generationIntentId String?                   @unique
  generationIntent   ContractGenerationIntent? @relation(fields: [generationIntentId], references: [id])

  // 多对多覆盖
  orderCoverage OrderContractCoverage[]
  // 文件附件（复用 ContractAttachment）
  attachments   ContractAttachment[]

  @@index([templateId])
  @@index([createdById])
  @@index([createdAt])
  @@index([departmentSnapshot])
}

/// Agent 合同生成意图：与 proposal 生命周期解耦的稳定幂等键。
/// PENDING/PROCESSING 时占用 activeDigestKey；GENERATED/EXPIRED 后清空，允许合法重复生成。
model ContractGenerationIntent {
  id                   String            @id @default(cuid())
  ownerUserId          String
  /// 规范化完整输入的 sha256（用于同 digest 复用判断）
  inputDigest          String
  /// 解析默认值后的完整有效输入 JSON
  normalizedInputJson  String
  /// 活跃唯一键：PENDING/PROCESSING 时为 `${ownerUserId}::${inputDigest}`，GENERATED/EXPIRED 时置 null
  activeDigestKey      String?           @unique
  status               String            @default("PENDING") // PENDING | PROCESSING | GENERATED | EXPIRED
  /// PROCESSING 态绑定的 proposalId（fencing token）
  processingProposalId String?
  processingStartedAt  DateTime?
  createdAt            DateTime          @default(now())
  expiresAt            DateTime
  contract             ContractDocument?

  @@index([ownerUserId, inputDigest, status])
}

// 合同↔订单 多对多覆盖（类比 OrderInvoiceCoverage）
model OrderContractCoverage {
  id         String           @id @default(cuid())
  contract   ContractDocument @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId String
  order      Order            @relation("OrderContractCoverages", fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  createdAt  DateTime         @default(now())

  @@unique([contractId, orderId])
  @@index([orderId])
  @@index([contractId])
}

// ============================================================
// 商务邮件通知（见 docs/business-email-notification-design-2026-06-26.md）
// ============================================================

// 项目周期节点（milestone）
model Milestone {
  id                String    @id @default(cuid())
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  name              String // 节点名称，如"样本送检""报告交付"
  type              String    @default("CUSTOM") // CUSTOM | SAMPLE | SEQUENCING | REPORT | DELIVERY | ...
  sortOrder         Int       @default(0)
  dueDate           DateTime? // 计划到期日
  doneAt            DateTime? // 实际完成时间
  completedNotified Boolean   @default(false) // 邮件 D（逾期后完成通知）确已发出（权威标志，重开时重置）
  note              String?

  // 通知配置
  notifyBeforeHours Int? // 到期前 N 小时提醒项目成员（null=不提前提醒）
  contacts          MilestoneContact[] // 该节点催办的外部部门收件人

  // 催办锁机（复用 Ticket 锁机结构）
  nudgeStatus     String?   @default("PENDING") // PENDING | PROCESSING | SENT | FAILED | DONE
  nudgeLockedAt   DateTime?
  nudgeLastSentAt DateTime? // 最近一次催办时间（手动+自动共用，用于 24h 去重 + 1h 手动限速）
  nudgeError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([dueDate, nudgeStatus])
}

// 节点 ↔ 外部收件人
model MilestoneContact {
  id                String          @id @default(cuid())
  milestone         Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId       String
  externalContact   ExternalContact @relation(fields: [externalContactId], references: [id])
  externalContactId String
  suppressUntil     DateTime? // 临时静默截止时间，null=不静默

  @@unique([milestoneId, externalContactId])
  @@index([milestoneId])
}

// 外部部门通讯录
model ExternalContact {
  id          String   @id @default(cuid())
  name        String // 部门/联系人名称，如"财务部""测序合作组"
  email       String // 收件邮箱
  department  String? // 所属部门（可选，便于分组；财务部催办用固定值 FINANCE）
  description String?
  ccEmails    String? // 抄送邮箱（逗号分隔多个）
  enabled     Boolean  @default(true) // 临时禁用开关（false=不参与任何发送）
  archived    Boolean  @default(false) // 软删除
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones MilestoneContact[]

  @@index([archived, enabled])
}

// 归档就绪提醒去重
model ProjectArchiveNotice {
  id         String    @id @default(cuid())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  notifiedAt DateTime  @default(now()) // 何时发出"可归档"提醒
  archivedAt DateTime? // 何时真正归档（归档邮件发出时回填）

  @@unique([projectId]) // 一个项目最多一条"可归档"提醒
}

// 商务邮件发送历史（仅外部收件人邮件 B/C/D/E/F/F2；成员通知 A/G 见站内通知中心）
// 见 docs/business-email-notification-design-2026-06-26.md §9 第二期 item 4
model BusinessEmailLog {
  id          String   @id @default(cuid())
  type        String // BUSINESS_EMAIL_TYPE 之一
  toEmail     String // 主收件邮箱
  toName      String? // 收件人/部门名称
  ccEmails    String? // 抄送邮箱（逗号分隔，快照）
  subject     String // 邮件标题
  status      String // sent | failed
  error       String? // 失败原因（status=failed 时）
  contactId   String? // 关联 ExternalContact id（若有）
  projectId   String? // 关联项目（节点类邮件）
  milestoneId String? // 关联节点（节点类邮件）
  invoiceId   String? // 关联发票申请（发票类邮件）
  // 下单代表通知（H）：聚合邮件按订单逐条落日志（沿用 projectId/milestoneId 的纯 String 无 FK 惯例）。
  orderId          String? // 关联订单（下单通知）
  representativeId String? // 收件代表（下单通知）
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([orderId])
  @@index([representativeId])
}

// ─── Order Import Session (导入前确认会话) ───────────────────
// 见 docs/order-import-crm-confirmation-design-2026-06-29.md §6
model OrderImportSession {
  id             String   @id @default(cuid())
  source         String
  sourceRemark   String?
  category       String   @default("UNKNOWN")
  status         String   @default("DRAFT") // DRAFT / REVIEWING / READY / COMMITTED / ABORTED / FAILED
  fileName       String?
  rawColumnsJson String?
  summaryJson    String?
  createdById    String
  // 顺序导入升级（docs/agent-sequential-order-import-upgrade-design-2026-07-21.md §4.2）：
  // 页面与 Agent 共用同一会话。inputChannel 标记来源渠道；stagingFileId/agentRunId/parserKey
  // 仅用于会话恢复与展示，createdById 仍是权限主权。
  inputChannel   String   @default("PAGE") // PAGE | AGENT
  stagingFileId  String?
  agentRunId     String?
  parserKey      String? // ORDER_GENERIC | PINGOODMICE
  rowCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User             @relation("OrderImportSessionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  rows      OrderImportRow[]

  @@index([createdById, createdAt])
  @@index([status])
  @@index([agentRunId])
}

model OrderImportRow {
  id        String @id @default(cuid())
  sessionId String
  rowNo     Int

  rawPayloadJson        String
  normalizedPayloadJson String

  // 完整状态集合（与设计文档 §4.3 行状态一致）：
  //   解析/标准化失败：PARSE_FAILED
  //   待确认（阻塞 commit）：PENDING、AUTO_SUGGESTED、AMBIGUOUS、NO_MATCH、REPRESENTATIVE_MISSING
  //   决策就绪（可生成 proposal）：CONFIRMED_EXISTING、CONFIRMED_CREATE
  //   等待确认：PROPOSED（唯一 PENDING proposal 已持久化，proposalId 必须非空）
  //   执行租约：IMPORTING（proposal 已确认，单行事务正在执行）
  //   终态：IMPORTED、DROPPED、FAILED
  // DROPPED 是"被用户显式剔除"的统一终态，原状态 + 原因记入 finalError。
  reviewStatus String @default("PENDING")

  suggestedProfileId String?
  suggestedScore     Float?
  suggestedReason    String?
  // candidateListJson 不持久化（按需重算），见设计文档 §6.4.1

  decisionType            String? // USE_SUGGESTION / PICK_EXISTING / CREATE_NEW
  confirmedProfileId      String?
  createCustomerDraftJson String?

  finalOrderId String?
  finalError   String?

  // 顺序导入升级（§4.3）：单行 proposal 生命周期与字段来源审计。
  // version 每次修改标准化数据、客户决定或 proposal 生命周期时递增，用于乐观并发控制。
  version             Int       @default(1)
  proposalId          String?
  claimRunId          String?
  claimStartedAt      DateTime?
  fieldProvenanceJson String? // 字段来源：FILE | USER_MESSAGE | VERIFIED_CONTEXT | CRM_SEARCH | DERIVED
  updatePlanJson      String? // CREATE / UPDATE / CONFLICT 计划与 diff 快照

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session          OrderImportSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  suggestedProfile CrmCustomerProfile? @relation("ImportRowSuggestedProfile", fields: [suggestedProfileId], references: [id], onDelete: SetNull)
  confirmedProfile CrmCustomerProfile? @relation("ImportRowConfirmedProfile", fields: [confirmedProfileId], references: [id], onDelete: SetNull)

  @@unique([sessionId, rowNo])
  @@index([sessionId, reviewStatus])
  @@index([suggestedProfileId])
  @@index([confirmedProfileId])
  @@index([proposalId])
}

// ─────────────────────────────────────────────────────────────────
// 供应链管理与成本核算（设计文档 supply-costing-architecture-design-2026-07-10.md）
// Phase 0-4 模型。金额一律 Int 分（元×100）。枚举使用 String + 应用层常量。
// ─────────────────────────────────────────────────────────────────

// 标准服务项字典（Phase 0）
model ServiceCatalog {
  id          String   @id @default(cuid())
  serviceKey  String   @unique
  name        String
  category    String   @default("SERVICE") // SERVICE | PRODUCT | MIXED | OTHER
  domain      String? // SEQUENCING | LIBRARY_PREP | SPATIAL | BIOINFORMATICS | LOGISTICS | OTHER
  aliasesJson String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([domain])
  @@index([active])
}

// 订单行到产品目录的绑定（Phase 1；目标重命名 OrderLineCatalogBinding）。
// productSkuId 是当前目录身份的唯一事实源；serviceKey 仅 legacy 兼容期保留。
// 兼容期不变量：productSkuId IS NOT NULL OR serviceKey IS NOT NULL（应用层 + 审计脚本守护）。
model OrderLineServiceMapping {
  id            String    @id @default(cuid())
  orderLineId   String    @unique
  orderLine     OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  productSkuId  String?
  productSku    ProductSku? @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  serviceKey    String? // legacy 快照，最终不再作为事实源
  confidence    Float?
  source        String    @default("MANUAL") // MANUAL | RULE | IMPORT | AI | HISTORY | MIGRATION_EXACT | AGENT_DRAFT
  matchedText   String?
  note          String?
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productSkuId])
  @@index([serviceKey])
  @@index([source])
}

// 供应商主档（Phase 1）
model Supplier {
  id             String  @id @default(cuid())
  name           String
  normalizedName String
  shortName      String?
  status         String  @default("ACTIVE") // ACTIVE | PAUSED | BLACKLISTED
  category       String? // SEQUENCING | LIBRARY_PREP | SPATIAL | LOGISTICS | OTHER
  region         String?

  contactName String?
  phone       String?
  email       String?
  wechat      String?
  address     String?
  contactNote String?

  paymentCycle         String? // PREPAID | NET_15 | NET_30 | NET_60 | MONTHLY | CUSTOM
  defaultLeadDays      Int?
  quoteUpdateCycleDays Int? // 默认报价更新周期；为空时走系统默认或按服务项规则
  lastQuoteUpdatedAt   DateTime?
  nextQuoteRefreshAt   DateTime?
  rating               Int?
  qualityScore         Float?
  deliveryScore        Float?
  priceScore           Float?

  tagsJson       String?
  preferenceNote String?
  riskNote       String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts        SupplierContact[]
  capabilities    SupplierCapability[]
  quotes          SupplierQuote[]
  inquiries       SupplierInquiry[]
  supplyPlanLines SupplyPlanLine[]
  costEntries     CostEntry[]
  payables        FinancePayable[]
  payments        FinancePayment[]

  @@index([normalizedName])
  @@index([status])
  @@index([category])
  @@index([nextQuoteRefreshAt])
  @@index([archived])
}

// 供应商联系人（Phase 1）
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String? // 销售、技术支持、财务、售后、负责人
  phone      String?
  email      String?
  wechat     String?
  qq         String?
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([isPrimary])
  @@index([active])
}

// 供应商能力范围（Phase 1）
model SupplierCapability {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productSkuId String?
  productSku   ProductSku? @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  supplierSkuCode String?
  serviceKey String? // legacy 标准服务项；兼容期 productSkuId IS NOT NULL OR serviceKey IS NOT NULL
  itemName   String
  spec       String?
  sampleType String?
  species    String?
  platform   String?
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([productSkuId])
  @@index([serviceKey])
  @@index([active])
}

// 供应商报价表（Phase 1）—— 价格事实，不等同于成本台账
model SupplierQuote {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productSkuId String?
  productSku   ProductSku? @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  supplierSkuCode String?
  serviceKey  String? // legacy；兼容期 productSkuId IS NOT NULL OR serviceKey IS NOT NULL
  itemName    String
  spec        String?
  unit        String?
  minQuantity Float?

  listPrice       Int // 目录价，分
  quotedPrice     Int // 当前报价，分
  negotiatedPrice Int? // 已议价报价，分
  floorPriceHint  Int? // 底价线索，敏感字段（API select 层控制可见性）
  discountRate    Float?

  leadDays        Int?
  validFrom       DateTime?
  validTo         DateTime?
  lastUpdatedAt   DateTime? // 业务上的价格更新时间
  updateCycleDays Int? // 本报价建议更新周期；为空时回退供应商 quoteUpdateCycleDays
  nextRefreshAt   DateTime? // 可由 lastUpdatedAt + updateCycleDays 推导后落库
  status          String    @default("ACTIVE") // ACTIVE | EXPIRED | ARCHIVED
  source          String    @default("MANUAL") // MANUAL | IMPORT | NEGOTIATION | ORDER_HISTORY
  sourceRef       String?
  remark          String?
  createdById     String?
  createdBy       User?     @relation("SupplierQuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([supplierId])
  @@index([productSkuId])
  @@index([serviceKey])
  @@index([status])
  @@index([validTo])
  @@index([nextRefreshAt])
}

// 询价和还价记录（Phase 1）
model SupplierInquiry {
  id               String   @id @default(cuid())
  departmentSnapshot String @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLineId      String?
  quoteId          String?
  status           String   @default("OPEN") // OPEN | RESPONDED | CLOSED | LOST
  requestedItem    String
  requestedSpec    String?
  quantity         Float?
  targetPrice      Int? // 分
  responsePrice    Int? // 分
  finalPrice       Int? // 分
  responseLeadDays Int?
  occurredAt       DateTime @default(now())
  contactMethod    String?
  note             String?
  rawText          String?
  createdById      String
  createdBy        User     @relation("SupplierInquiryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([supplierId])
  @@index([orderId])
  @@index([quoteId])
  @@index([status])
  @@index([departmentSnapshot])
}

// 订单供应方案（Phase 2）—— 供应链决策结果
model SupplyPlan {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  name             String?
  status           String    @default("DRAFT") // DRAFT | QUOTED | NEGOTIATING | SELECTED | LOCKED | SUPERSEDED | CANCELLED
  planType         String    @default("BALANCED") // LOWEST_COST | FASTEST | BALANCED | MANUAL
  totalQuotedCost  Int       @default(0) // 分
  totalLockedCost  Int? // 分
  expectedLeadDays Int?
  scoreJson        String?
  note             String?
  selectedAt       DateTime?
  lockedAt         DateTime?
  createdById      String
  createdBy        User      @relation("SupplyPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lines SupplyPlanLine[]

  @@index([orderId])
  @@index([status])
  @@index([createdById])
}

// 供应方案明细（Phase 2）—— 支持多行不同供应商混合承接
model SupplyPlanLine {
  id          String     @id @default(cuid())
  planId      String
  plan        SupplyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  orderLineId String?
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  supplyRequirementId String?
  supplyRequirement   SupplyRequirement? @relation(fields: [supplyRequirementId], references: [id], onDelete: SetNull)
  // INTERNAL BOM 组件无供应商报价；legacy/外采行必须有 supplierId
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quoteId     String?
  inquiryId   String?

  productSkuId String?
  productSku   ProductSku? @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  // BOM 组件使用组件自身编号；DIRECT 用销售 SKU；legacy 可为空
  productCodeSnapshot String?
  skuCodeSnapshot     String?
  // legacy serviceKey 快照；锁定时与报价 serviceKey 核对
  serviceKeySnapshot  String?
  itemName     String
  spec         String?
  unit         String?
  quantity     Float?
  unitCost     Int // 分
  amount       Int // 分；amount === Math.round(quantity * unitCost)
  discountRate Float?
  leadDays     Int?
  // 候选生成时的 definitionHash 快照；锁定时与 requirement / 当前 BOM 三方比较
  definitionHash String?
  // BOM 组件角色快照：PROCUREMENT | INTERNAL | LOGISTICS | OPTIONAL；DIRECT/legacy 为 null
  componentRole  String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([planId])
  @@index([orderLineId])
  @@index([supplyRequirementId])
  @@index([supplierId])
  @@index([quoteId])
}

// 成本核算事实（Phase 1）—— 可来自供应方案、手动录入、规则、导入或历史兼容
model CostEntry {
  id String @id @default(cuid())
  departmentSnapshot String @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）

  subjectType String // ORDER | PROJECT | CUSTOMER | MANUAL
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  profileId   String?
  profile     CrmCustomerProfile? @relation("ProfileCostEntries", fields: [profileId], references: [id], onDelete: SetNull)

  bucket            String // REAL | CIRCULATION | TAX
  costType          String // PROCUREMENT | SUPPLIER | EXPERIMENT | LABOR | LOGISTICS | COMMISSION | PLATFORM | PLATFORM_FEE | MARKETING | ENTERTAINMENT | REFUND | TAX | PROJECT_COST | OTHER
  status            String  @default("ESTIMATED") // ESTIMATED | QUOTED | COMMITTED | ACTUAL | SETTLED | CANCELLED
  amount            Int // 分
  currency          String  @default("CNY")
  effectiveGroupKey String? // 同一成本来源的版本分组；聚合时每组只取最高确定性有效版本

  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quoteId          String?
  supplyPlanId     String?
  supplyPlanLineId String?

  // Phase 3：行级与 SKU 维度。SUPPLY_PLAN 成本必须有 orderId+orderLineId+productSkuId+supplyPlanLineId。
  orderLineId         String?
  productSkuId        String?
  productSku          ProductSku? @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  supplyRequirementId String?
  supplyRequirement   SupplyRequirement? @relation(fields: [supplyRequirementId], references: [id], onDelete: SetNull)
  productCodeSnapshot String?
  skuCodeSnapshot     String?

  taxRate       Float?
  taxIncluded   Boolean?
  taxMode       String? // TAX_EXCLUSIVE | TAX_INCLUSIVE | TAX_ONLY
  occurredAt    DateTime  @default(now())
  expectedPayAt DateTime?
  settledAt     DateTime?

  sourceType  String   @default("MANUAL") // MANUAL | SUPPLY_PLAN | TAX_RULE | CIRCULATION_RULE | IMPORT | LEGACY_FINANCE_COST | PROJECT_BUDGET_COST | ORDER_INITIAL_COST | CONTRACT_IMPORT | COMMISSION
  sourceKey   String?
  remark      String?
  createdById String
  createdBy   User     @relation("CostEntryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payableLinks FinancePayable[]

  @@unique([sourceType, sourceKey])
  @@index([subjectType])
  @@index([orderId])
  @@index([projectId])
  @@index([profileId])
  @@index([bucket])
  @@index([status])
  @@index([supplierId])
  @@index([effectiveGroupKey])
  @@index([sourceType])
  @@index([orderLineId])
  @@index([productSkuId])
  @@index([supplyRequirementId])
  @@index([departmentSnapshot])
}

// 成本摘要缓存（Phase 1）—— 对外模块优先读这个
model CostSnapshot {
  id          String @id @default(cuid())
  subjectType String // ORDER | PROJECT | CUSTOMER
  subjectId   String

  realCost        Int @default(0) // 分
  circulationCost Int @default(0) // 分
  taxCost         Int @default(0) // 分
  fullCost        Int @default(0) // 分

  estimatedCost Int @default(0) // 分
  quotedCost    Int @default(0) // 分
  committedCost Int @default(0) // 分
  actualCost    Int @default(0) // 分
  settledCost   Int @default(0) // 分

  sourceHash   String?
  recomputedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subjectType, subjectId])
}

// 成本规则（Phase 2.5）—— 平台费、提成、固定手续费等
model CostRule {
  id          String   @id @default(cuid())
  name        String
  bucket      String // CIRCULATION | TAX
  costType    String // COMMISSION | PLATFORM_FEE | TAX | OTHER
  subjectType String // ORDER | PROJECT | CUSTOMER
  trigger     String // ORDER_CONFIRMED | ORDER_CLOSED | PLAN_LOCKED | MANUAL_RECOMPUTE
  formulaType String // FIXED_AMOUNT | PERCENT_OF_REVENUE | PERCENT_OF_REAL_COST
  rate        Float?
  amount      Int? // 分（FIXED_AMOUNT 时）
  active      Boolean  @default(true)
  priority    Int      @default(0)
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bucket])
  @@index([trigger])
  @@index([active])
  @@index([subjectType])
}

// 财务供应商应付（Phase 3）—— 只记录真实要付的钱
model FinancePayable {
  id              String     @id @default(cuid())
  departmentSnapshot String   @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  supplierId      String
  supplier        Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?     @relation("FinancePayableOrder", fields: [orderId], references: [id], onDelete: SetNull)
  projectId       String?
  costEntryId     String?
  costEntry       CostEntry? @relation(fields: [costEntryId], references: [id], onDelete: SetNull)
  supplyPlanId    String?
  payableGroupKey String? // 允许按供应商+订单/项目/方案合并应付

  amount      Int // 分
  paidAmount  Int       @default(0) // 分（缓存，事实源为分摊表聚合）
  status      String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERPAID | CANCELLED
  dueAt       DateTime?
  payableAt   DateTime?
  note        String?
  createdById String
  createdBy   User      @relation("FinancePayableCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  sourceType  String    @default("MANUAL") // MANUAL | COST_ENTRY | SUPPLY_PLAN
  sourceKey   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  allocations FinancePaymentAllocation[]

  @@unique([sourceType, sourceKey])
  @@index([supplierId])
  @@index([orderId])
  @@index([projectId])
  @@index([costEntryId])
  @@index([supplyPlanId])
  @@index([payableGroupKey])
  @@index([status])
  @@index([departmentSnapshot])
}

// 财务供应商付款流水（Phase 3）
model FinancePayment {
  id          String   @id @default(cuid())
  departmentSnapshot String @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount      Int // 分
  paidAt      DateTime @default(now())
  method      String?
  voucherNo   String?
  voucherUrl  String?
  remark      String?
  createdById String
  createdBy   User     @relation("FinancePaymentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  allocations FinancePaymentAllocation[]

  @@index([supplierId])
  @@index([paidAt])
  @@index([departmentSnapshot])
}

// 供应商付款分摊表（Phase 3）—— 支持一笔付款核销多笔应付
model FinancePaymentAllocation {
  id          String         @id @default(cuid())
  paymentId   String
  payment     FinancePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payableId   String
  payable     FinancePayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount      Int // 分
  createdById String
  createdBy   User           @relation("FinancePaymentAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([paymentId, payableId])
  @@index([paymentId])
  @@index([payableId])
}

/// CRM 客户偏好——人工标注 + 自动洞察统一存储。
/// 挂在 CrmCustomerProfile 下，不回写 Customer 旧业务字段。
/// sourceType 区分来源（MANUAL / ORDER_RULE / INTERACTION_AI / COMPLAINT / SYSTEM）。
/// @@unique([sourceType, key]) 保证同来源同 key 幂等（自动洞察重算 / 客诉摘要派生）。
model CrmCustomerPreference {
  id               String             @id @default(cuid())
  departmentSnapshot String           @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  profile          CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  category         String // AVAILABILITY | CONTACT_STYLE | NEGOTIATION | DISCOUNT_PROFILE | PRODUCT_INTEREST | ORDER_BEHAVIOR | LOGISTICS | DECISION | COMPLAINT_SUMMARY | OTHER
  key              String // 稳定机器键，用于自动规则和聚合
  label            String // 展示标题
  valueText        String? // 人类可读内容
  valueJson        String? // 结构化值（JSON 字符串），供自动规则使用
  sourceType       String // MANUAL | ORDER_RULE | INTERACTION_AI | COMPLAINT | SYSTEM
  confidence       Float? // 自动洞察置信度 0-1
  evidenceType     String? // 证据类型（ORDER / INTERACTION / COMPLAINT 等）
  evidenceId       String? // 证据 ID（软引用）
  status           String             @default("ACTIVE") // ACTIVE | DISMISSED | SUPERSEDED | ARCHIVED
  reviewStatus     String             @default("PENDING") // PENDING | ACCEPTED | REJECTED（仅自动洞察有意义）
  reviewedByUserId String?
  reviewedByUser   User?              @relation("CrmPreferenceReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  pinned           Boolean            @default(false) // 是否置顶
  note             String? // 内部备注
  createdById      String
  createdBy        User               @relation("CrmPreferenceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedByUserId  String?
  updatedByUser    User?              @relation("CrmPreferenceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([profileId, sourceType, key])
  @@index([profileId, status, pinned])
  @@index([sourceType, key])
  @@index([category])
  @@index([departmentSnapshot])
}

/// CRM 客诉工单——独立生命周期，不只是一条偏好备注。
/// 创建/解决时联动 CrmFollowUpTask（sourceType = CRM_COMPLAINT）。
/// 关闭后派生 COMPLAINT_SUMMARY 偏好（key = complaint:<id>:summary，幂等）。
model CrmComplaint {
  id                   String             @id @default(cuid())
  departmentSnapshot   String             @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  profile              CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId            String
  title                String
  description          String?
  category             String // DELIVERY_DELAY | QUALITY | PRICE | COMMUNICATION | LOGISTICS | INVOICE_PAYMENT | AFTER_SALES | OTHER
  severity             String // LOW | MEDIUM | HIGH | CRITICAL
  status               String             @default("OPEN") // OPEN | IN_PROGRESS | WAITING_CUSTOMER | RESOLVED | CLOSED | CANCELLED
  ownerUserId          String?
  ownerUser            User?              @relation("CrmComplaintOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sourceType           String? // 客诉来源（INTERACTION / ORDER / MANUAL 等）
  sourceId             String? // 来源 ID
  relatedOrderId       String?
  relatedOrder         Order?             @relation("CrmComplaintOrder", fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedProjectId     String?
  relatedProject       Project?           @relation("CrmComplaintProject", fields: [relatedProjectId], references: [id], onDelete: SetNull)
  relatedInteractionId String?
  relatedInteraction   CrmInteraction?    @relation("CrmComplaintInteraction", fields: [relatedInteractionId], references: [id], onDelete: SetNull)
  expectedResolutionAt DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  resolutionSummary    String?
  customerSatisfied    Boolean?
  createdById          String
  createdBy            User               @relation("CrmComplaintCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  events CrmComplaintEvent[]

  @@index([profileId, status])
  @@index([status, severity])
  @@index([ownerUserId, status])
  @@index([relatedOrderId])
  @@index([relatedProjectId])
  @@index([departmentSnapshot])
}

/// 客诉处理事件流水——状态变化/处理记录/负责人变化/回访结论。
model CrmComplaintEvent {
  id          String       @id @default(cuid())
  complaint   CrmComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId String
  eventType   String // COMMENT | STATUS_CHANGED | ASSIGNED | CUSTOMER_CONTACTED | RESOLUTION_PROPOSED | RESOLVED | REOPENED | CLOSED
  fromStatus  String?
  toStatus    String?
  content     String?
  createdById String
  createdBy   User         @relation("CrmComplaintEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([complaintId, createdAt])
}

// ─────────────────────────────────────────────────────────────────
// 产品目录与订单—供应链—成本一体化（2026-07-27）
// docs/product-catalog-order-supply-cost-integration-design-2026-07-27.md
// 金额一律 Int 分（元×100）。枚举使用 String + 应用层常量。
// ─────────────────────────────────────────────────────────────────

/// 通用业务编号序列（原子 upsert，保证 PRD-/SKU- 并发安全）。
model BusinessSequence {
  key         String   @id // PRODUCT | PRODUCT_SKU | 后续可扩展 ORDER/PROJECT
  currentValue Int     @default(0)
  updatedAt   DateTime @updatedAt
}

/// 产品/服务族（SPU）。回答"这是什么产品"。
model Product {
  id          String   @id @default(cuid())
  productCode String   @unique // PRD-000001，一经使用不可修改
  name        String
  kind        String   @default("SERVICE") // SERVICE | PHYSICAL | DIGITAL | COMPOSITE | OTHER
  domain      String? // SEQUENCING | LIBRARY_PREP | SPATIAL | BIOINFORMATICS | LOGISTICS | OTHER
  status      String   @default("DRAFT") // DRAFT | ACTIVE | RETIRED | MERGED
  description String?
  createdById String
  createdBy   User     @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skus        ProductSku[]
  aliases     ProductAlias[]
  changeLogs  ProductChangeLog[]

  @@index([kind, status])
  @@index([domain, status])
}

/// 具体可售/可采购规格（内部货号）。回答"实际卖/买的是哪个规格和货号"。
model ProductSku {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  skuCode           String   @unique // SKU-000001，一经使用不可修改
  name              String
  spec              String?
  standardUnit      String
  sellable          Boolean  @default(true)
  purchasable       Boolean  @default(true)
  fulfillmentMode   String   @default("EXTERNAL_OR_INTERNAL") // EXTERNAL_OR_INTERNAL | INTERNAL_ONLY | EXTERNAL_ONLY
  defaultSalesPrice Int? // 分，仅默认值，不覆盖订单成交价
  status            String   @default("DRAFT") // DRAFT | ACTIVE | RETIRED | MERGED
  replacementSkuId  String? // MERGED 时指向替代 SKU（不建 FK，避免环）
  createdById       String
  createdBy         User     @relation("ProductSkuCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 反向关系：订单行绑定、供应商能力/报价、BOM 组件、供应需求、方案行、成本、变更日志
  orderLineMappings   OrderLineServiceMapping[]
  supplierCapabilities SupplierCapability[]
  supplierQuotes      SupplierQuote[]
  parentComponents    ProductSkuComponent[] @relation("ProductSkuComponentParent")
  childComponents     ProductSkuComponent[] @relation("ProductSkuComponentChild")
  supplyRequirements  SupplyRequirement[]
  supplyPlanLines     SupplyPlanLine[]
  costEntries         CostEntry[]

  @@index([productId, status])
  @@index([sellable, status])
  @@index([purchasable, status])
}

/// 产品别名（用于历史自由文本匹配、供应商货号归一、搜索命中）。
model ProductAlias {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  source          String  @default("MANUAL") // MANUAL | IMPORT | LEGACY_SERVICE_KEY | SUPPLIER_SKU_CODE

  @@unique([productId, normalizedAlias])
  @@index([normalizedAlias])
}

/// BOM / 履约组成（Phase 2）。普通 SKU 无组件时直接生成 1 条供应需求；
/// 组合 SKU 按组件展开多条。INTERNAL 组件进内部成本，不强制供应商报价。
model ProductSkuComponent {
  id             String     @id @default(cuid())
  parentSkuId    String
  parentSku      ProductSku @relation("ProductSkuComponentParent", fields: [parentSkuId], references: [id], onDelete: Cascade)
  componentSkuId String
  componentSku   ProductSku @relation("ProductSkuComponentChild", fields: [componentSkuId], references: [id], onDelete: Restrict)
  quantity       Float      @default(1)
  role           String     @default("PROCUREMENT") // PROCUREMENT | INTERNAL | LOGISTICS | OPTIONAL
  lossRate       Float?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([parentSkuId, componentSkuId, role])
  @@index([parentSkuId, active])
  @@index([componentSkuId])
}

/// 产品/SKU 变更日志（字段级 before/after，便于审计和回溯）。
model ProductChangeLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuId       String?
  action      String // PRODUCT_CREATED | PRODUCT_UPDATED | PRODUCT_RETIRED | SKU_CREATED | SKU_UPDATED | SKU_RETIRED | SKU_MERGED | ALIAS_ADDED | ALIAS_REMOVED
  field       String?
  beforeValue String?
  afterValue  String?
  note        String?
  createdById String
  createdBy   User     @relation("ProductChangeLogCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([skuId])
  @@index([action])
}

/// 供应需求（Phase 2）。订单行或 BOM 展开的采购需求，是 SupplyPlanLine 的上游。
model SupplyRequirement {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId     String
  orderLine       OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  productSkuId    String
  productSku      ProductSku @relation(fields: [productSkuId], references: [id], onDelete: Restrict)
  source          String    @default("DIRECT") // DIRECT | BOM
  // BOM 展开路径，含角色以区分同 SKU 多 role：root>{componentSkuId}:{role}；DIRECT 为 null
  componentPath   String?
  // BOM 组件角色：PROCUREMENT | INTERNAL | LOGISTICS | OPTIONAL；DIRECT 为 null
  componentRole   String?
  // review #4：BOM 需求的 productSkuId 是组件 SKU，但 definitionHash 基于根销售 SKU 的 BOM。
  // 锁定复算时需读根 SKU 的 BOM，故持久化 rootSkuId。DIRECT 需求 rootSkuId = productSkuId。
  rootSkuId       String?
  quantity        Float
  unit            String
  status          String    @default("OPEN") // OPEN | PLANNED | LOCKED | CANCELLED
  nameSnapshot    String
  skuCodeSnapshot String
  productCodeSnapshot String?
  revision        Int       @default(1)
  definitionHash  String // 生成时的 SKU+BOM+数量+单位定义哈希，锁定方案时复核
  supersedesRequirementId String? // 刷新时旧需求 → 新需求（不建 FK，避免锁链）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplyPlanLines SupplyPlanLine[]
  costEntries     CostEntry[]

  @@index([orderId, status])
  @@index([orderLineId])
  @@index([productSkuId, status])
  @@index([orderLineId, productSkuId, componentRole])
  @@index([rootSkuId])
  @@index([status])
}

/// 历史治理关系（Phase 0 / Phase 4）。PRJ-OTHER 不复用普通财务关系，
/// 只回答"这条历史记录当前还没有可靠真实项目归属，暂放哪个治理队列"。
model ProjectGovernanceAssignment {
  id                   String    @id @default(cuid())
  governanceProjectId  String
  governanceProject    Project   @relation("ProjectGovernanceAssignments", fields: [governanceProjectId], references: [id], onDelete: Restrict)
  legacyProjectId      String?
  orderId              String?
  sourceRecordId       String?
  // review #5：active subject key（type:id）。OPEN 时写入用于幂等唯一约束；
  // 进入终态（RESOLVED/IGNORED）时清空为 null，使同一 subject 可被重新打开，
  // 历史终态记录可保留多条（activeSubjectKey=null 不参与唯一约束）。
  activeSubjectKey     String?
  departmentId         String?
  reasonCode           String // MISSING_PROJECT_NO | UNRESOLVED_PROJECT | LEGACY_MISC
  status               String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  resolvedProjectId    String?
  resolvedProject      Project?  @relation("ProjectGovernanceResolvedProject", fields: [resolvedProjectId], references: [id], onDelete: Restrict)
  note                 String?
  createdById          String
  createdBy            User      @relation("ProjectGovernanceAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?

  // 同治理桶 + 同 activeSubjectKey 只能有一个 active（OPEN）assignment（并发安全幂等）
  // SQLite 将 NULL 视为不重复，因此终态（activeSubjectKey=null）可保留多条历史。
  @@unique([governanceProjectId, activeSubjectKey])
  @@index([governanceProjectId, status])
  @@index([legacyProjectId])
  @@index([orderId])
  @@index([status])
}

/// 客户 Profile 的部门认领状态（设计 §4.4）。每个 profile 为每个部门维护一行。
model CrmProfileDepartmentState {
  id                   String             @id @default(cuid())
  profileId            String
  profile              CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  department           String
  claimStatus          String             @default("POOL") // CLAIMED | RECALL_CANDIDATE | POOL
  ownerUserId          String?
  ownerUser            User?              @relation("ProfileDepartmentOwners", fields: [ownerUserId], references: [id], onDelete: Restrict)
  stage                String?
  importance           String?
  source               String?
  claimedAt            DateTime?
  claimedById          String?
  claimedBy            User?              @relation("ProfileDepartmentClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  poolEntryReason      String?             // null=从未由本部门持有；RELEASED | OWNER_UNAVAILABLE
  releasedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([profileId, department])
  @@index([department, claimStatus])
  @@index([department, ownerUserId, claimStatus])
}

/// 定向公海共享授权（设计 §4.5）。来源部门控制目标部门公海可见性。
model CrmProfilePoolShare {
  id               String             @id @default(cuid())
  profileId        String
  profile          CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceDepartment String
  targetDepartment String
  status           String             @default("ACTIVE") // ACTIVE | REVOKED
  sharedByUserId   String
  sharedByUser     User               @relation("ProfilePoolSharesCreated", fields: [sharedByUserId], references: [id], onDelete: Restrict)
  sharedAt         DateTime           @default(now())
  revokedByUserId  String?
  revokedByUser    User?              @relation("ProfilePoolSharesRevoked", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([profileId, sourceDepartment, targetDepartment])
  @@index([targetDepartment, status, sharedAt])
  @@index([sourceDepartment, status])
}

/// 客服号（设计 §4.6）。第一期只允许 ONLINE_OPS。
model CustomerServiceAccount {
  id          String   @id @default(cuid())
  wechatId    String   @unique
  name        String
  department  String   @default("ONLINE_OPS")
  ownerUserId String
  ownerUser   User     @relation("ManagedServiceAccounts", fields: [ownerUserId], references: [id], onDelete: Restrict)
  status      String   @default("ACTIVE") // ACTIVE | DISABLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department, ownerUserId, status])
}
