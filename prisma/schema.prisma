generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 部署期一次性迁移 marker（由 Prisma 管理，避免 db push 把表当 drift 删掉）。
/// 行存在即证明对应迁移已完成；勿随意删除。
/// createdAt 用 String 对齐三审 raw 表 TEXT DEFAULT datetime('now')，避免升级时
/// String→DateTime cast 触发 --accept-data-loss。
model MigrationMarker {
  key       String @id
  value     String
  createdAt String @default(dbgenerated("(datetime('now'))"))

  @@map("_MigrationMarker")
}

model User {
  id                                String                                 @id @default(cuid())
  email                             String                                 @unique
  name                              String
  password                          String
  avatar                            String?
  role                              String                                 @default("USER")
  department                        String                                 @default("FIELD_SALES")
  passwordInitialized               Boolean                                @default(true)
  emailOnReminder                   Boolean                                @default(true)
  emailOnStatusChange               Boolean                                @default(true)
  emailOnTicketReply                Boolean                                @default(true)
  emailOnComment                    Boolean                                @default(true)
  createdAt                         DateTime                               @default(now())
  projects                          ProjectMember[]
  comments                          Comment[]
  projectNotes                      ProjectNote[]                          @relation("ProjectNoteAuthor")
  tickets                           Ticket[]
  replies                           TicketReply[]
  activities                        ActivityLog[]
  reviewsCreated                    OrganizationReviewTask[]               @relation("ReviewCreatedBy")
  reviewsReviewed                   OrganizationReviewTask[]               @relation("ReviewReviewedBy")
  reviewedOrders                    ExternalOrder[]                        @relation("OrderReview")
  devLogs                           DevLog[]
  invoicesCreated                   ProjectInvoice[]
  externalOrderImportBatches        ExternalOrderImportBatch[]
  externalOrderInvoicesCreated      ExternalOrderInvoiceRequest[]
  financeReceiptsCreated            FinanceReceipt[]
  financeCostsCreated               FinanceCost[]
  crmOwnedProfiles                  CrmCustomerProfile[]                   @relation("CrmOwnedProfiles")
  crmInteractionsCreated            CrmInteraction[]                       @relation("CrmInteractionsCreated")
  crmFollowUpOwned                  CrmFollowUpTask[]                      @relation("CrmFollowUpOwner")
  crmFollowUpCreated                CrmFollowUpTask[]                      @relation("CrmFollowUpCreatedBy")
  crmCheckinsCreated                CrmVisitCheckin[]                      @relation("CrmCheckinCreatedBy")
  crmAddressesVerified              CrmCustomerAddress[]                   @relation("CrmAddressVerifiedBy")
  customerRelationsCreated          CustomerRelation[]
  crmApplicationsSubmitted          CrmCustomerApplication[]               @relation("CrmApplicationsSubmitted")
  crmApplicationsReviewed           CrmCustomerApplication[]               @relation("CrmApplicationsReviewed")
  crmApplicationsAdminReviewed      CrmCustomerApplication[]               @relation("CrmApplicationsAdminReviewed")
  crmApplicationsSupervisorReviewed CrmCustomerApplication[]               @relation("CrmApplicationsSupervisorReviewed")
  repOrgRequested                   RepresentativeOrganization[]           @relation("RepOrgRequestedBy")
  repOrgReviewed                    RepresentativeOrganization[]           @relation("RepOrgReviewedBy")
  appSupervisorEmailTracking        CrmApplicationSupervisorNotification[]
  supervisorReviewDigest            CrmApplicationSupervisorDigest?
  reportDraftsCreated               CrmRepresentativeReportDraft[]         @relation("ReportDraftCreatedBy")
  reportDraftsUpdated               CrmRepresentativeReportDraft[]         @relation("ReportDraftUpdatedBy")
  RegionManagers                    CrmRegionManager[]
  crmProfilesAssigned               CrmCustomerProfile[]                   @relation("CrmAssignedByUser")
  crmProfilesRecalled               CrmCustomerProfile[]                   @relation("CrmRecalledByUser")
  assignmentLogsFrom                CrmCustomerAssignmentLog[]             @relation("AssignmentFromUser")
  assignmentLogsTo                  CrmCustomerAssignmentLog[]             @relation("AssignmentToUser")
  assignmentLogsCreated             CrmCustomerAssignmentLog[]             @relation("AssignmentCreatedBy")
  ordersCreated                     Order[]                                @relation("OrdersCreated")
  ordersOwned                       Order[]                                @relation("OrderOwner")
  technicallyOwnedOrders            Order[]                                @relation("TechnicallyOwnedOrders")
  technicallyOwnedProjects          Project[]                              @relation("TechnicallyOwnedProjects")
  governanceTasksResolved           TechnicalOwnerGovernanceTask[]         @relation("GovernanceResolvedBy")
  orderDraftsOwned                  OrderDraft[]                           @relation("OrderDraftsOwnedBy")
  orderProjectLinksCreated          OrderProjectLink[]                     @relation("OrderProjectLinksCreated")
  orderStatusHistoryCreated         OrderStatusHistory[]                   @relation("OrderStatusHistoryCreated")
  orderMergesCreated                OrderMerge[]                           @relation("OrderMergeCreated")
  orderImportBatches                OrderImportBatch[]                     @relation("OrderImportBatchCreatedBy")
  invoiceDocumentsUploaded          InvoiceDocument[]                      @relation("InvoiceDocumentsUploadedBy")
  invoiceAdjustmentsCreated         InvoiceAdjustment[]                    @relation("InvoiceAdjustmentCreatedBy")
  advancesCreated                   FinanceAdvance[]                       @relation("FinanceAdvanceCreatedBy")
  advanceRefundsCreated             FinanceAdvanceRefund[]                 @relation("FinanceAdvanceRefundCreatedBy")
  revisionsCreated                  OrderRevision[]                        @relation("OrderRevisionCreatedBy")
  financeReceiptAllocations         FinanceReceiptAllocation[]             @relation("ReceiptAllocationCreatedBy")
  contractAttachmentsUploaded       ContractAttachment[]                   @relation("ContractAttachmentsUploadedBy")
  commissionsCreated                FinanceCommission[]                    @relation("FinanceCommissionCreatedBy")
  mergeLogsOperated                 CustomerMergeLog[]                     @relation("MergeLogsOperated")
  mergeLogsReversed                 CustomerMergeLog[]                     @relation("MergeLogsReversed")
  mergeTasksScanned                 CustomerMergeTask[]                    @relation("MergeTasksScanned")
  mergeTasksResolved                CustomerMergeTask[]                    @relation("MergeTasksResolved")
  customerRepTagsCreated            CustomerRepTag[]                       @relation("CustomerRepTagsCreatedBy")
  contractTemplatesCreated          ContractTemplate[]                     @relation("ContractTemplatesCreatedBy")
  contractTemplatesUpdated          ContractTemplate[]                     @relation("ContractTemplatesUpdatedBy")
  contractDocumentsCreated          ContractDocument[]                     @relation("ContractDocumentsCreatedBy")
  orgBindingTasksScanned            CustomerOrgBindingTask[]               @relation("OrgBindingScannedBy")
  orgBindingTasksResolved           CustomerOrgBindingTask[]               @relation("OrgBindingResolvedBy")
  orgTextDriftTasksScanned          CustomerOrgTextDriftTask[]             @relation("OrgTextDriftScannedBy")
  orgTextDriftTasksResolved         CustomerOrgTextDriftTask[]             @relation("OrgTextDriftResolvedBy")
  orderImportSessions               OrderImportSession[]                   @relation("OrderImportSessionCreatedBy")
  supplyChainCostEntriesCreated     CostEntry[]                            @relation("CostEntryCreatedBy")
  supplyChainPlansCreated           SupplyPlan[]                           @relation("SupplyPlanCreatedBy")
  supplyChainInquiriesCreated       SupplierInquiry[]                      @relation("SupplierInquiryCreatedBy")
  supplyChainQuotesCreated          SupplierQuote[]                        @relation("SupplierQuoteCreatedBy")
  supplierFinancePayablesCreated    FinancePayable[]                       @relation("FinancePayableCreatedBy")
  supplierFinancePaymentsCreated    FinancePayment[]                       @relation("FinancePaymentCreatedBy")
  supplierFinancePaymentAllocations FinancePaymentAllocation[]             @relation("FinancePaymentAllocationCreatedBy")
  crmPreferencesCreated             CrmCustomerPreference[]                @relation("CrmPreferenceCreatedBy")
  crmPreferencesUpdated             CrmCustomerPreference[]                @relation("CrmPreferenceUpdatedBy")
  crmPreferencesReviewed            CrmCustomerPreference[]                @relation("CrmPreferenceReviewedBy")
  crmComplaintsOwned                CrmComplaint[]                         @relation("CrmComplaintOwner")
  crmComplaintsCreated              CrmComplaint[]                         @relation("CrmComplaintCreatedBy")
  crmComplaintEventsCreated         CrmComplaintEvent[]                    @relation("CrmComplaintEventCreatedBy")
  customerNameAliasesCreated        CrmCustomerNameAlias[]                 @relation("CustomerNameAliasesCreatedBy")
  invitationsCreated                UserInvitation[]                       @relation("UserInvitationsCreatedBy")
  invitationsReceived               UserInvitation[]                       @relation("UserInvitationsForUser")
  productsCreated                   Product[]                              @relation("ProductCreatedBy")
  productSkusCreated                ProductSku[]                           @relation("ProductSkuCreatedBy")
  productChangeLogsCreated          ProductChangeLog[]                     @relation("ProductChangeLogCreatedBy")
  projectGovernanceAssignmentsCreated ProjectGovernanceAssignment[]         @relation("ProjectGovernanceAssignmentCreatedBy")
  profileDepartmentOwnerships         CrmProfileDepartmentState[] @relation("ProfileDepartmentOwners")
  profileDepartmentClaims             CrmProfileDepartmentState[] @relation("ProfileDepartmentClaimedBy")
  profilePoolSharesCreated            CrmProfilePoolShare[]       @relation("ProfilePoolSharesCreated")
  profilePoolSharesRevoked            CrmProfilePoolShare[]       @relation("ProfilePoolSharesRevoked")
  managedServiceAccounts              CustomerServiceAccount[]    @relation("ManagedServiceAccounts")

  @@index([department])
}

model Representative {
  id                   String                           @id @default(cuid())
  name                 String
  email                String                           @unique
  token                String?                          @unique // Magic Link token
  tokenExpiresAt       DateTime?
  kind                 String                           @default("HUMAN") // HUMAN | SYSTEM（本部系统代表，排除提成/KPI/排行榜/magic link）
  archived             Boolean                          @default(false)
  archivedAt           DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  projects             Project[]
  orders               Order[]
  regionManagerLinks   CrmRegionManagerRepresentative[]
  regionAssignments    RepresentativeRegionAssignment[]
  reportDrafts         CrmRepresentativeReportDraft[]
  organizationBindings RepresentativeOrganization[]
  commissionTiers      RepresentativeCommissionTier[]
  commissions          FinanceCommission[]
  customerRepTags      CustomerRepTag[]
}

model ProcurementChannel {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SourceBrand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id                           String                        @id @default(cuid())
  orgCode                      String                        @unique
  canonicalName                String
  normalizedName               String
  address                      String?
  taxId                        String?
  // Invoice four elements (发票四要素)
  invoiceAddress               String?
  invoicePhone                 String?
  invoiceBankName              String?
  invoiceBankAccount           String?
  // Normalization markers
  isInvoiceSubject             Boolean                       @default(false)
  taxIdVerifiedAt              DateTime?
  taxIdVerifySource            String?
  orgDataSource                String                        @default("MANUAL") // MANUAL, INVOICE_API, GOVERNANCE
  archived                     Boolean                       @default(false)
  deleted                      Boolean                       @default(false)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  aliases                      OrganizationAlias[]
  sites                        OrganizationSite[]
  reviewTasks                  OrganizationReviewTask[]
  invoicesAsBuyer              ProjectInvoice[]
  externalOrderInvoicesAsBuyer ExternalOrderInvoiceRequest[]
  buyerOrders                  Order[]                       @relation("OrderBuyerOrganization")
  representativeBindings       RepresentativeOrganization[]
  financeReceipts              FinanceReceipt[]
  crmApplications              CrmCustomerApplication[]      @relation("CrmApplicationsOrg")
  suggestedOrgBindingTasks     CustomerOrgBindingTask[]      @relation("OrgBindingSuggestedOrg")
  resolvedOrgBindingTasks      CustomerOrgBindingTask[]      @relation("OrgBindingResolvedOrg")
  crmProfiles                  CrmCustomerProfile[]          @relation("ProfileOrg")

  @@index([taxId])
  @@index([isInvoiceSubject])
}

model OrganizationAlias {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  alias           String
  normalizedAlias String
  aliasType       String       @default("COMMON") // COMMON, ABBREVIATION, FORMER_NAME
  approved        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  @@index([normalizedAlias])
}

model OrganizationSite {
  id                       String                       @id @default(cuid())
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId           String
  siteName                 String
  normalizedSiteName       String
  siteType                 String                       @default("CAMPUS") // CAMPUS, COLLEGE, LAB, BUILDING, UNIT
  parentSiteId             String? // soft reference to another OrganizationSite (no FK — SQLite ALTER TABLE limitation)
  address                  String?
  archived                 Boolean                      @default(false)
  // site merge hierarchy record (Task 1.4 preserveHierarchy / D9)
  mergedFromJson           String? // JSON: [{ siteId, siteName, mergedAt }] — sites merged into this one
  // site geolocation (Task 1.7/1.13 高德 Amap; fields only, logic added later)
  lat                      Float?
  lng                      Float?
  geocodeSource            String? // MANUAL | POI_SEARCH | GEOCODE | REVERSE_GEOCODE
  geocodedAt               DateTime?
  geocodeRawJson           String?
  createdAt                DateTime                     @default(now())
  reviewTasks              OrganizationReviewTask[]
  representativeBindings   RepresentativeOrganization[]
  suggestedOrgBindingTasks CustomerOrgBindingTask[]     @relation("OrgBindingSuggestedSite")
  resolvedOrgBindingTasks  CustomerOrgBindingTask[]     @relation("OrgBindingResolvedSite")
  crmProfiles              CrmCustomerProfile[]         @relation("ProfileOrgSite")

  @@unique([organizationId, normalizedSiteName])
  @@index([normalizedSiteName])
  @@index([siteType])
}

model OrganizationReviewTask {
  id                      String            @id @default(cuid())
  rawInput                String
  normalizedInput         String
  suggestedOrganizationId String?
  suggestedOrg            Organization?     @relation(fields: [suggestedOrganizationId], references: [id], onDelete: SetNull)
  suggestedSiteId         String?
  suggestedSite           OrganizationSite? @relation(fields: [suggestedSiteId], references: [id], onDelete: SetNull)
  suggestedCanonicalName  String?
  suggestedAddress        String?
  confidence              Float?
  status                  String            @default("PENDING") // PENDING, APPROVED, REJECTED
  sourceType              String // CUSTOMER_CREATE, CUSTOMER_EDIT, SMART_FILL
  sourceId                String
  createdById             String?
  createdByUser           User?             @relation("ReviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById            String?
  reviewedByUser          User?             @relation("ReviewReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote              String?
  resolutionSource        String? // DB_EXACT, DB_CANDIDATE, LLM_DB_CANDIDATE, MANUAL_NEW, MANUAL_FORCE_NEW, MANUAL_MERGED_TO_EXISTING, TAVILY_MINIMAX_DRAFT
  suggestedAliasesJson    String?
  suggestedSitesJson      String?
  evidenceJson            String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  reviewedAt              DateTime?

  repOrgBindingRequests RepresentativeOrganization[]

  @@index([status])
  @@index([sourceType, sourceId])
}

model Project {
  id                  String                @id @default(cuid())
  departmentSnapshot  String                @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  name                String
  description         String?
  projectNo           String?               @unique
  orderNumber         String?
  organization        String?
  client              String?
  representative      String?
  representativeId    String?
  rep                 Representative?       @relation(fields: [representativeId], references: [id], onDelete: SetNull)
  profileId           String?
  profile             CrmCustomerProfile?   @relation("ProfileProjects", fields: [profileId], references: [id], onDelete: SetNull)
  projectType         String?
  projectContent      String?
  quantity            Int?
  procurementSource   String?
  brand               String?
  techSupport         String?
  /// 技术负责人（Phase E）：Agent project 写的唯一授权源。历史 techSupport 仅展示字符串，
  /// 不能授权。null = Agent 写 fail-closed。
  technicalOwnerUserId String?
  technicalOwner       User? @relation("TechnicallyOwnedProjects", fields: [technicalOwnerUserId], references: [id], onDelete: SetNull)
  budgetAmount        Int? // 单位：分（元×100）
  budgetAmountSource  String? // null | MANUAL | ORDER_LINK
  budgetCost          Int? // 单位：分（元×100）
  status              String                @default("NOT_STARTED")
  progress            Int                   @default(0)
  startDate           DateTime?
  endDate             DateTime?
  deliveredAt         DateTime? // 交付时间（合同台账 N 列，区别于 endDate，不参与 progress-receivables）
  terminatedAt        DateTime? // 终止时间（合同台账 O 列）
  archived            Boolean               @default(false)
  deleted             Boolean               @default(false)
  deletedAt           DateTime?
  deletedReason       String?
  // 产品目录与治理桶设计：NORMAL=普通项目；GOVERNANCE_BUCKET=系统治理桶（如 PRJ-OTHER）。
  // 项目查询 scope 必须用 { AND: [scope, { systemType: "NORMAL" }, filters] } 排除治理桶。
  systemType          String                @default("NORMAL") // NORMAL | GOVERNANCE_BUCKET
  systemKey           String?               @unique // 如 GENERAL_OTHER_PROJECT；普通项目为 null
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  members             ProjectMember[]
  statusHistory       StatusHistory[]
  tickets             Ticket[]
  comments            Comment[]
  notes               ProjectNote[]
  attachments         Attachment[]
  activities          ActivityLog[]
  invoices            ProjectInvoice[]
  externalOrders      ExternalOrder[]
  orderLinks          OrderProjectLink[]
  receipts            FinanceReceipt[]
  financeCosts        FinanceCost[]
  advances            FinanceAdvance[]      @relation("FinanceAdvanceProject")
  contractAttachments ContractAttachment[]
  commissions         FinanceCommission[]
  milestones          Milestone[]
  archiveNotice       ProjectArchiveNotice?
  costEntries         CostEntry[]
  complaints          CrmComplaint[]        @relation("CrmComplaintProject")
  governanceAssignments ProjectGovernanceAssignment[] @relation("ProjectGovernanceAssignments")
  governanceResolutions ProjectGovernanceAssignment[] @relation("ProjectGovernanceResolvedProject")

  @@index([profileId])
  @@index([systemType])
  @@index([departmentSnapshot])
}

model ProjectMember {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model StatusHistory {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  oldStatus String?
  newStatus String
  note      String?
  createdAt DateTime @default(now())
  createdBy String
}

model Ticket {
  id               String        @id @default(cuid())
  title            String
  description      String?
  status           String        @default("OPEN")
  priority         String        @default("MEDIUM")
  reminderDate     DateTime?
  reminderSent     Boolean       @default(false)
  reminderStatus   String?       @default("PENDING") // PENDING | PROCESSING | SENT | FAILED
  reminderLockedAt DateTime?
  reminderSentAt   DateTime?
  reminderError    String?
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  assignee         User?         @relation(fields: [assigneeId], references: [id])
  assigneeId       String?
  createdBy        String? // User ID who created this ticket
  replies          TicketReply[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
}

model ProjectNote {
  id                    String   @id @default(cuid())
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             String
  authorId              String?
  author                User?    @relation("ProjectNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorNameSnapshot    String
  category              String   @default("GENERAL")
  content               String
  visibility            String   @default("INTERNAL")
  source                String   @default("AGENT")
  sourceAgentProposalId String?  @unique
  createdAt             DateTime @default(now())
  noteAttachments       ProjectNoteAttachment[]

  @@index([projectId, createdAt, id])
  @@index([projectId, category])
}

/// 项目备注 ↔ 附件的结构化关联（docs §5）。备注文本中的 Markdown URL 不能充当审计关系或幂等键。
model ProjectNoteAttachment {
  noteId       String
  note         ProjectNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  sortOrder    Int
  createdAt    DateTime    @default(now())

  @@id([noteId, attachmentId])
  @@index([attachmentId])
}

model TicketReply {
  id        String   @id @default(cuid())
  content   String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  mimeType  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())
  // ── Agent 私有附件扩展（docs/agent-attachment-routing-design-2026-07-24.md §5）──
  // 历史 public 行保持 storageKey=null / isPrivate=false / source=PROJECT_UI / status=READY。
  // 新 Agent 私有项目附件：isPrivate=true、storageKey 指向 AGENT_PROJECT_ATTACHMENT_DIR 相对键、
  // url 为同源受控内容端点。所有列表/详情/时间线/计数/下载只允许 status=READY。
  storageKey             String?  @unique
  isPrivate              Boolean  @default(false)
  source                 String   @default("PROJECT_UI") // PROJECT_UI | AGENT
  status                 String   @default("READY") // READY | PENDING_FILE | FAILED | PURGING | MIGRATING
  agentAttachmentRouteId String?  @unique
  // 业务可见性归档（软删）：归档后从列表/时间线/计数/下载隐藏，DB 行与私有文件保留，可恢复。
  // 与 status（文件物理状态机）正交：status=READY 且 archived=false 才对用户可见。
  // MIGRATING：历史 public→private 迁移中（已持久化目标 storageKey；url 仍指向 public，可崩溃恢复）。
  archived               Boolean  @default(false)
  archivedAt             DateTime?
  noteLinks              ProjectNoteAttachment[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  content   String
  metadata  String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String
  type        String   @default("SYSTEM")
  read        Boolean  @default(false)
  link        String?
  emailStatus String? // null=no email, "pending", "sent", "failed"
  emailError  String?
  dedupeKey   String?  @unique
  createdAt   DateTime @default(now())
}

model FailedLoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique // email or "ip:email"
  attempts    Int       @default(0)
  lastAttempt DateTime  @default(now())
  lockedUntil DateTime?
}

/// Internal user account setup / password reset invitations.
/// This is a separate authentication system from Representative Magic Link tokens
/// (Representative.token). The two must never share token generation or consumption logic.
model UserInvitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserInvitationsForUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     String    @default("ACCOUNT_SETUP") // ACCOUNT_SETUP | PASSWORD_RESET
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("UserInvitationsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model DevLog {
  id          String    @id @default(cuid())
  version     String?
  title       String
  content     String
  status      String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  type        String    @default("UPDATE") // UPDATE, FIX, RELEASE, NOTICE
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([createdAt])
}

model ProjectInvoice {
  id                    String               @id @default(cuid())
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             String
  contactName           String?
  projectCode           String?
  sellerProfile         BillingProfile?      @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  sellerProfileId       String?
  sellerName            String?
  sellerTaxId           String?
  sellerBankName        String?
  sellerBankAccount     String?
  sellerAddress         String?
  sellerPhone           String?
  buyerOrganization     Organization?        @relation(fields: [buyerOrganizationId], references: [id], onDelete: SetNull)
  buyerOrganizationId   String?
  buyerOrganizationName String
  buyerTaxId            String?
  buyerTaxIdFromLookup  Boolean              @default(false)
  invoiceType           String               @default("NORMAL") // NORMAL, SPECIAL
  contentSummary        String?
  totalAmount           Int                  @default(0) // 单位：分（元×100）
  status                String               @default("DRAFT") // DRAFT, REQUESTED, ISSUED, CANCELLED
  remark                String?
  actualInvoiceNo       String?
  actualIssuedAt        DateTime?
  createdBy             User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  items                 ProjectInvoiceItem[]
  receipts              FinanceReceipt[]
  documents             InvoiceDocument[]

  @@index([projectId])
}

model ProjectInvoiceItem {
  id        String         @id @default(cuid())
  invoice   ProjectInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  sortOrder Int            @default(0)
  itemName  String
  spec      String?
  unit      String?
  quantity  Float?
  amount    Int            @default(0) // 单位：分（元×100）

  @@index([invoiceId])
}

model BillingProfile {
  id                    String                        @id @default(cuid())
  name                  String
  taxId                 String?
  bankName              String?
  bankAccount           String?
  address               String?
  phone                 String?
  legalRepresentative   String? // 法定代表人/委托代理人（合同生成用）
  isDefault             Boolean                       @default(false)
  archived              Boolean                       @default(false)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  invoices              ProjectInvoice[]
  externalOrderInvoices ExternalOrderInvoiceRequest[]
}

model ExternalOrderImportBatch {
  id                 String          @id @default(cuid())
  departmentSnapshot String          @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2：旧模型停止写入，存量统一 FIELD_SALES）
  source             String
  rawText            String
  rowCount           Int
  createdBy          User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById        String
  createdAt          DateTime        @default(now())
  orders             ExternalOrder[]

  @@index([departmentSnapshot])
}

model OrderImportBatch {
  id               String   @id @default(cuid())
  source           String
  importMode       String   @default("DIRECT") // DIRECT | AI_NORMALIZED
  status           String   @default("PREVIEWED") // PREVIEWED | NORMALIZED | IMPORTED | FAILED
  originalFilename String?
  originalMimeType String?
  rawText          String?
  rawPreviewJson   String?
  normalizedJson   String?
  formatJson       String?
  warningJson      String?
  createdById      String
  createdBy        User     @relation("OrderImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ExternalOrder {
  id                    String                         @id @default(cuid())
  departmentSnapshot    String                         @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  source                String
  platform              String?
  externalOrderNo       String
  merchantOrderNo       String?
  storeName             String?
  orderType             String?
  receiverName          String?
  receiverPhone         String?
  receiverAddress       String?
  orderUser             String?
  orderUserTags         String?
  productNamesRaw       String?
  productNamesJson      String?
  itemCount             Int?
  itemTypeCount         Int?
  orderAt               DateTime?
  paidAt                DateTime?
  scheduledDeliveryText String?
  sellerMessage         String?
  merchantRemark        String?
  formNote              String?
  grossAmount           Int? // 单位：分（元×100）
  priceAdjustment       Int? // 单位：分（元×100）
  paidAmount            Int? // 单位：分（元×100）
  shippingFee           Int? // 单位：分（元×100）
  importBatch           ExternalOrderImportBatch       @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importBatchId         String
  rawJson               String?
  invoiceStatus         String                         @default("NONE")
  duplicateGroupId      String?
  duplicateStatus       String                         @default("UNREVIEWED")
  mergedIntoId          String?
  mergedInto            ExternalOrder?                 @relation("OrderMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom            ExternalOrder[]                @relation("OrderMerge")
  reviewNote            String?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            User?                          @relation("OrderReview", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  invoiceRequests       ExternalOrderInvoiceRequest[]
  invoiceCoverage       ExternalOrderInvoiceCoverage[]
  profileId             String?
  profile               CrmCustomerProfile?            @relation("ProfileExternalOrders", fields: [profileId], references: [id], onDelete: SetNull)
  projectId             String?
  project               Project?                       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerMatchStatus   String                         @default("UNMATCHED")
  customerMatchScore    Float?
  customerMatchReason   String?
  financeCategory       String                         @default("UNKNOWN")
  financeTreatment      String                         @default("AUTO")
  financeAmountOverride Int? // 单位：分（元×100）
  financeNote           String?
  receipts              FinanceReceipt[]

  @@unique([source, externalOrderNo])
  @@index([externalOrderNo])
  @@index([receiverPhone])
  @@index([orderAt])
  @@index([importBatchId])
  @@index([duplicateStatus])
  @@index([duplicateGroupId])
  @@index([profileId])
  @@index([projectId])
  @@index([customerMatchStatus])
  @@index([departmentSnapshot])
}

model ExternalOrderInvoiceRequest {
  id                     String                         @id @default(cuid())
  departmentSnapshot     String                         @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  externalOrder          ExternalOrder?                 @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  externalOrderId        String?
  orderId                String?
  order                  Order?                         @relation("OrderInvoiceRequests", fields: [orderId], references: [id], onDelete: SetNull)
  contactName            String?
  sellerProfile          BillingProfile?                @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  sellerProfileId        String?
  sellerName             String?
  sellerTaxId            String?
  sellerBankName         String?
  sellerBankAccount      String?
  sellerAddress          String?
  sellerPhone            String?
  buyerOrganization      Organization?                  @relation(fields: [buyerOrganizationId], references: [id], onDelete: SetNull)
  buyerOrganizationId    String?
  buyerOrganizationName  String
  buyerTaxId             String?
  buyerTaxIdFromLookup   Boolean                        @default(false)
  invoiceType            String                         @default("NORMAL")
  contentSummary         String?
  totalAmount            Int                            @default(0) // 单位：分（元×100）
  status                 String                         @default("DRAFT")
  remark                 String?
  actualInvoiceNo        String?
  actualIssuedAt         DateTime?
  sourceAgentProposalId  String?                        @unique
  submittedAt            DateTime?
  // 发票超期催办锁机（与 Ticket 锁机结构一致，见设计文档 §3.5）
  overdueNudgeSent       Boolean                        @default(false)
  overdueNudgeStatus     String?                        @default("PENDING") // PENDING | PROCESSING | SENT | FAILED
  overdueNudgeLockedAt   DateTime?
  overdueNudgeLastSentAt DateTime?
  overdueNudgeError      String?
  createdBy              User                           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById            String
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  items                  ExternalOrderInvoiceItem[]
  receipts               FinanceReceipt[]
  coverage               ExternalOrderInvoiceCoverage[]
  orderCoverage          OrderInvoiceCoverage[]
  documents              InvoiceDocument[]
  adjustmentsAsOriginal  InvoiceAdjustment[]            @relation("OriginalInvoice")
  adjustmentsAsNew       InvoiceAdjustment[]            @relation("NewInvoice")
  allocations            FinanceReceiptAllocation[]

  @@index([externalOrderId])
  @@index([departmentSnapshot])
}

model InvoiceAdjustment {
  id                String                       @id @default(cuid())
  kind              String // RED | REISSUE
  reason            String?
  originalInvoice   ExternalOrderInvoiceRequest  @relation("OriginalInvoice", fields: [originalInvoiceId], references: [id], onDelete: Cascade)
  originalInvoiceId String
  newInvoice        ExternalOrderInvoiceRequest? @relation("NewInvoice", fields: [newInvoiceId], references: [id], onDelete: SetNull)
  newInvoiceId      String?
  createdBy         User                         @relation("InvoiceAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById       String
  createdAt         DateTime                     @default(now())

  @@unique([originalInvoiceId])
  @@index([originalInvoiceId])
  @@index([newInvoiceId])
  @@index([createdById])
}

model ExternalOrderInvoiceItem {
  id               String                      @id @default(cuid())
  invoiceRequest   ExternalOrderInvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  invoiceRequestId String
  sortOrder        Int                         @default(0)
  itemName         String
  spec             String?
  unit             String?
  quantity         Float?
  amount           Int                         @default(0) // 单位：分（元×100）

  @@index([invoiceRequestId])
}

model ExternalOrderInvoiceCoverage {
  id               String                      @id @default(cuid())
  invoiceRequest   ExternalOrderInvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  invoiceRequestId String
  externalOrder    ExternalOrder               @relation(fields: [externalOrderId], references: [id], onDelete: Cascade)
  externalOrderId  String
  createdAt        DateTime                    @default(now())

  @@unique([invoiceRequestId, externalOrderId])
  @@index([externalOrderId])
  @@index([invoiceRequestId])
}

model OrderInvoiceCoverage {
  id               String                      @id @default(cuid())
  invoiceRequest   ExternalOrderInvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Cascade)
  invoiceRequestId String
  order            Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  // 这张发票里这个订单承担的金额（单位：分），含主订单。完整分摊表事实源，禁止比例推导。
  // @default(0) 仅为停服迁移加列的过渡机制；应用写入必须显式给值，回填后不变量扫描保证有效发票的 amount > 0。
  // 见 finance-invoice-architecture-review §3.1 / §4.1。
  amount           Int                         @default(0)
  createdAt        DateTime                    @default(now())

  @@unique([invoiceRequestId, orderId])
  @@index([orderId])
  @@index([invoiceRequestId])
}

model InvoiceDocument {
  id                            String                       @id @default(cuid())
  projectInvoiceId              String?
  projectInvoice                ProjectInvoice?              @relation(fields: [projectInvoiceId], references: [id], onDelete: Cascade)
  externalOrderInvoiceRequestId String?
  externalOrderInvoiceRequest   ExternalOrderInvoiceRequest? @relation(fields: [externalOrderInvoiceRequestId], references: [id], onDelete: Cascade)
  kind                          String                       @default("ACTUAL_INVOICE") // ACTUAL_INVOICE | RED_INVOICE | OTHER
  fileName                      String
  fileUrl                       String
  fileSize                      Int
  mimeType                      String
  sha256                        String?
  sourceAgentProposalId         String?                      @unique
  uploadedById                  String
  uploadedBy                    User                         @relation("InvoiceDocumentsUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt                     DateTime                     @default(now())

  @@unique([externalOrderInvoiceRequestId, sha256])
  @@index([projectInvoiceId])
  @@index([externalOrderInvoiceRequestId])
  @@index([sha256])
}

/// 已开票发票号占用锁：防止并发双登记同一票号。冲红/取消后应释放（后续）。
model IssuedInvoiceNumberClaim {
  actualInvoiceNo  String   @id
  invoiceRequestId String   @unique
  createdAt        DateTime @default(now())
}

/// 已开票文件哈希占用锁：防止同一文件并发登记到不同申请。
model IssuedInvoiceFileHashClaim {
  sha256           String   @id
  invoiceRequestId String
  documentId       String   @unique
  createdAt        DateTime @default(now())

  @@index([invoiceRequestId])
}

model FinanceReceipt {
  id                            String                       @id @default(cuid())
  departmentSnapshot            String                       @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  profileId                     String?
  profile                       CrmCustomerProfile?          @relation("ProfileFinanceReceipts", fields: [profileId], references: [id], onDelete: SetNull)
  projectId                     String?
  project                       Project?                     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  externalOrderId               String?
  externalOrder                 ExternalOrder?               @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  orderId                       String?
  order                         Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  projectInvoiceId              String?
  projectInvoice                ProjectInvoice?              @relation(fields: [projectInvoiceId], references: [id], onDelete: SetNull)
  externalOrderInvoiceRequestId String?
  externalOrderInvoiceRequest   ExternalOrderInvoiceRequest? @relation(fields: [externalOrderInvoiceRequestId], references: [id], onDelete: SetNull)
  organizationId                String?
  organization                  Organization?                @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  amount                        Int // 单位：分（元×100）
  receivedAt                    DateTime                     @default(now())
  source                        String                       @default("MANUAL")
  remark                        String?
  createdById                   String
  createdBy                     User                         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  settledAdvances               FinanceAdvance[]             @relation("AdvanceSettledByReceipt")
  settledAdvanceRefunds         FinanceAdvanceRefund[]       @relation("AdvanceRefundSettledByReceipt")
  deleted                       Boolean                      @default(false)
  deletedAt                     DateTime?
  deletedById                   String?
  deleteReason                  String?
  deletionLogs                  FinanceReceiptDeletionLog[]
  allocations                   FinanceReceiptAllocation[]
  // Agent 银行流水批次幂等键（与 proposal 生命周期解耦）
  sourceWorkspaceId             String? // AgentTaskWorkspace.id
  sourceRowIndex                Int? // 银行流水行号（同一 workspace 内唯一）
  // Agent proposal 级幂等键：finance.create_receipt 单回款确认链按 proposalId
  // 冻结——业务写入成功后、proposal finalize 前进程崩溃/租约回收导致同
  // proposal 重执行时，唯一约束兜底幂等回放，不再重复创建回款与核销。
  // 银行流水批量确认不用此键（一个 proposal 多笔回款，走 workspace+row）。
  sourceAgentProposalId         String?                      @unique

  @@unique([sourceWorkspaceId, sourceRowIndex])
  @@index([profileId])
  @@index([projectId])
  @@index([externalOrderId])
  @@index([orderId])
  @@index([receivedAt])
  @@index([deleted])
  @@index([deletedAt])
  @@index([organizationId])
  @@index([departmentSnapshot])
}

model FinanceReceiptDeletionLog {
  id           String         @id @default(cuid())
  receiptId    String
  receipt      FinanceReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  amount       Int // 单位：分（元×100）
  receivedAt   DateTime
  orderId      String?
  profileId    String? // Phase C 扩表：Profile 快照，无 FK
  projectId    String?
  source       String?
  remark       String?
  reason       String?
  snapshotJson String
  deletedById  String
  deletedAt    DateTime       @default(now())

  @@index([receiptId])
  @@index([deletedAt])
}

model FinanceReceiptAllocation {
  id          String                      @id @default(cuid())
  receiptId   String
  receipt     FinanceReceipt              @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId   String // ExternalOrderInvoiceRequest.id
  invoice     ExternalOrderInvoiceRequest @relation(fields: [invoiceId], references: [id])
  // 回款按订单维度核销：一条 allocation = 某发票里某订单（coverage 行）的一次核销。
  // 非空以支撑 [receiptId, invoiceId, orderId] 唯一约束（SQLite 对含 NULL 的唯一约束不判重）。
  // 见 finance-invoice-architecture-review §3.2。
  orderId     String
  order       Order                       @relation(fields: [orderId], references: [id])
  amount      Int // 单位：分（元×100）。本次核销分摊金额
  createdById String?
  createdBy   User?                       @relation("ReceiptAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                    @default(now())

  @@unique([receiptId, invoiceId, orderId])
  @@index([invoiceId])
  @@index([orderId])
  @@index([createdById])
}

model FinanceAdvance {
  id                 String                 @id @default(cuid())
  departmentSnapshot String                 @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  profileId          String?
  profile            CrmCustomerProfile?    @relation("FinanceAdvanceProfile", fields: [profileId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?                 @relation("FinanceAdvanceOrder", fields: [orderId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?               @relation("FinanceAdvanceProject", fields: [projectId], references: [id], onDelete: SetNull)
  amount             Int // 单位：分（元×100）
  advancedAt         DateTime               @default(now())
  status             String                 @default("HELD") // HELD | PARTIAL_REFUNDED | REFUNDED | WRITTEN_OFF
  settledByReceiptId String?
  settledByReceipt   FinanceReceipt?        @relation("AdvanceSettledByReceipt", fields: [settledByReceiptId], references: [id], onDelete: SetNull)
  remark             String?
  createdById        String
  createdBy          User                   @relation("FinanceAdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  refunds            FinanceAdvanceRefund[]

  @@index([profileId])
  @@index([orderId])
  @@index([projectId])
  @@index([status])
  @@index([departmentSnapshot])
}

model FinanceAdvanceRefund {
  id                 String          @id @default(cuid())
  advanceId          String
  advance            FinanceAdvance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  settledByReceiptId String?
  settledByReceipt   FinanceReceipt? @relation("AdvanceRefundSettledByReceipt", fields: [settledByReceiptId], references: [id], onDelete: SetNull)
  amount             Int // 单位：分（元×100）
  refundedAt         DateTime        @default(now())
  remark             String?
  createdById        String
  createdBy          User            @relation("FinanceAdvanceRefundCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())

  @@index([advanceId])
  @@index([settledByReceiptId])
}

// ─── Unified Order Models ────────────────────────────────────

model Order {
  id                    String  @id @default(cuid())
  departmentSnapshot    String  @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  orderNo               String  @unique
  source                String  @default("MANUAL")
  sourcePlatform        String?
  sourceRemark          String?
  externalOrderNo       String?
  merchantOrderNo       String?
  legacyExternalOrderId String? @unique

  title       String
  description String?
  category    String    @default("UNKNOWN")
  status      String    @default("DRAFT")
  orderedAt   DateTime?
  confirmedAt DateTime?
  deliveredAt DateTime?

  profileId                  String?
  profile                    CrmCustomerProfile? @relation("ProfileOrders", fields: [profileId], references: [id], onDelete: SetNull)
  buyerNameSnapshot          String?
  buyerPhoneSnapshot         String?
  buyerWechatSnapshot        String?
  buyerMiniProgramIdSnapshot String?
  buyerOrgNameSnapshot       String?
  buyerAddressSnapshot       String?
  // 结构化购买方机构外键（批量开票默认分组 / 跨购买方提示 / 凭证匹配机构口径的事实源）。
  // 最终发票抬头机构记录在 invoice.buyerOrganizationId，可与订单购买方机构不同。
  // buyerOrgNameSnapshot 仅作文本快照展示，不参与分组与财务校验。见 finance-invoice-architecture-review §3.3。
  buyerOrganizationId        String?
  buyerOrganization          Organization?       @relation("OrderBuyerOrganization", fields: [buyerOrganizationId], references: [id], onDelete: SetNull)

  customerMatchStatus String  @default("UNMATCHED")
  customerMatchScore  Float?
  customerMatchReason String?

  totalAmount           Int     @default(0) // 单位：分（元×100）
  financeAmountOverride Int? // 单位：分（元×100）
  financeTreatment      String  @default("AUTO")
  financeNote           String?

  commissionPaid Int? // 打款提成（合同台账 W 列），单位：分
  quarterlyBonus Int? // 季度超指标奖励（合同台账 X 列），单位：分

  ownerUserId      String?
  ownerUser        User?           @relation("OrderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// 订单技术支持（展示/业务事实源）。项目仅在生成时复制该值，绝不反向决定订单字段。
  techSupport      String?
  /// 技术负责人（Phase E）：Agent order/project 写的唯一授权源。与 ownerUserId（业务归属）
  /// 不同——technicalOwnerUserId 是"谁有资格经 Agent 改这个订单/项目"。
  /// 历史 techSupport 仅是展示字符串，不能授权。null = Agent 写 fail-closed（需 UI 治理）。
  technicalOwnerUserId String?
  technicalOwner       User?      @relation("TechnicallyOwnedOrders", fields: [technicalOwnerUserId], references: [id], onDelete: SetNull)
  representativeId String?
  representative   Representative? @relation(fields: [representativeId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User            @relation("OrdersCreated", fields: [createdById], references: [id], onDelete: Cascade)

  archived  Boolean   @default(false)
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ── 下单代表邮件通知状态机（轮询聚合，见 docs/order-rep-notify-email-design-2026-07-26.md §4.1） ──
  // PENDING | PROCESSING | SENT | FAILED | SKIPPED；锁机结构对标 overdueNudge* / nudge*。
  repNotifyStatus   String   @default("PENDING")
  repNotifyLockedAt DateTime?
  repNotifySentAt   DateTime?
  repNotifyError    String?
  repNotifyAttempts Int      @default(0)

  accrualReversalOfId String?
  accrualReversalOf   Order?  @relation("AccrualReversal", fields: [accrualReversalOfId], references: [id], onDelete: SetNull)
  accrualReversals    Order[] @relation("AccrualReversal")

  lines                   OrderLine[]
  sourceRecords           OrderSourceRecord[]
  projectLinks            OrderProjectLink[]
  statusHistory           OrderStatusHistory[]
  mergeSources            OrderMerge[]                  @relation("OrderMergeSource")
  mergeTargets            OrderMerge[]                  @relation("OrderMergeTarget")
  receipts                FinanceReceipt[]
  invoiceCoverage         OrderInvoiceCoverage[]
  invoiceRequests         ExternalOrderInvoiceRequest[] @relation("OrderInvoiceRequests")
  invoiceAllocations      FinanceReceiptAllocation[]
  financeCosts            FinanceCost[]
  advances                FinanceAdvance[]              @relation("FinanceAdvanceOrder")
  commissions             FinanceCommission[]
  contractAttachments     ContractAttachment[]
  contractCoverages       OrderContractCoverage[]       @relation("OrderContractCoverages")
  supplyPlans             SupplyPlan[]
  supplierInquiries       SupplierInquiry[]
  costEntries             CostEntry[]
  supplierFinancePayables FinancePayable[]              @relation("FinancePayableOrder")
  supplyRequirements      SupplyRequirement[]

  revisions OrderRevision[]

  complaints CrmComplaint[] @relation("CrmComplaintOrder")

  @@index([source, externalOrderNo])
  @@index([merchantOrderNo])
  @@index([profileId])
  @@index([ownerUserId])
  @@index([representativeId])
  @@index([status])
  @@index([category])
  @@index([orderedAt])
  @@index([deleted])
  @@index([buyerOrganizationId])
  @@index([repNotifyStatus, representativeId])
  @@index([departmentSnapshot])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName  String
  spec      String?
  unit      String?
  quantity  Float?
  unitPrice Int? // 单位：分（元×100）
  amount    Int     @default(0) // 单位：分（元×100）
  category  String  @default("UNKNOWN")
  sortOrder Int     @default(0)
  rawJson   String?

  // 产品目录身份成交时快照（Phase 1）。改目录后历史订单仍可解释，不联表。
