// ─── CRM Models ──────────────────────────────────────────────

model CrmCustomerProfile {
  id          String @id @default(cuid())
  // Phase E contract：Customer 锚点模型与旧锚点映射列已删除，
  // Profile 是客户身份的唯一事实源。
  ownerUserId String?
  ownerUser   User?  @relation("CrmOwnedProfiles", fields: [ownerUserId], references: [id], onDelete: SetNull)
  departmentStates  CrmProfileDepartmentState[]
  poolShares        CrmProfilePoolShare[]

  // ── 生命周期字段（Phase C 扩表，docs/customer-profile-master-migration-2026-06-29.md）──
  // 原从 Customer 锚点扩出的生命周期字段；Phase E contract 起 Profile 为唯一事实源。
  deleted             Boolean              @default(false)
  deletedAt           DateTime?
  mergedIntoProfileId String?
  mergedIntoProfile   CrmCustomerProfile?  @relation("ProfileMerge", fields: [mergedIntoProfileId], references: [id])
  mergedFromProfiles  CrmCustomerProfile[] @relation("ProfileMerge")

  // ── 客户业务主权字段（CrmCustomerProfile 主表化迁移，docs/customer-profile-master-migration-2026-06-29.md）──
  // Phase 1 全部 nullable-first；回填后 Phase 4 再评估是否收紧为必填。
  // 主权语义：Phase E contract 起这些字段是客户身份/联系方式/地址/机构的唯一权威来源。
  // 身份
  name                 String?
  // 去声调全拼（pinyin-pro），由写路径自动填充，用于语音同音错字检索（AGENT-VOICE-01）。
  // 如 name="王晓明" → namePinyin="wangxiaoming"，使 "王小明" 也能 SQL 命中。
  namePinyin           String?
  customerCode         String?           @unique
  nameDisambiguator    String?
  principal            String?
  labOrGroup           String?
  // 联系方式
  phone                String?
  wechat               String?
  email                String?
  miniProgramId        String?
  // 地址与收货快照（迁移期保留客户级快照；长期是否收敛到 CrmCustomerAddress 在 Phase 4 后单独评估）
  address              String?
  addressNote          String?
  receiverPhone        String?
  receiverAddress      String?
  // 机构
  organizationId       String?
  organization         String?
  organizationSiteId   String?
  organizationRawInput String?
  org                  Organization?     @relation("ProfileOrg", fields: [organizationId], references: [id], onDelete: SetNull)
  orgSite              OrganizationSite? @relation("ProfileOrgSite", fields: [organizationSiteId], references: [id], onDelete: SetNull)

  stage                     String                     @default("LEAD") // LEAD, CONTACTED, FOLLOWING, ACTIVE, BLOCKED, LOST, DORMANT
  importance                String                     @default("NORMAL") // LOW, NORMAL, HIGH, KEY
  tagsJson                  String?
  summary                   String?
  lastFollowUpAt            DateTime?
  nextFollowUpAt            DateTime?
  lastOrderAt               DateTime?
  lastActiveBehaviorEndedAt DateTime? // 最后一个 ACTIVE 行为（CONFIRMED 订单 / IN_PROGRESS 项目 / 履约任务）结束时间
  activeCooldownEndsAt      DateTime? // ACTIVE 冷却期结束时间（lastActiveBehaviorEndedAt + 30 天）
  activeWarningIssuedAt     DateTime? // ACTIVE 降级 warning 生成时间
  // assignmentStatus 语义（Phase 3.2 语义对齐）：这是一个由「客户池分配/回收」工作流显式驱动的
  // 独立状态机，4 个取值 UNASSIGNED | ASSIGNED | RECALL_CANDIDATE | RECALLED：
  //   - ASSIGNED        显式派单（/api/crm/customer-pool/[id]/assign）、订单主数据导入、profile 创建默认值
  //   - RECALL_CANDIDATE 显式标记为待收回候选（长期未拜访自动入池已暂停，/api/crm/customer-pool/scan no-op）
  //   - RECALLED        显式回收（/api/crm/customer-pool/[id]/recall）
  //   - UNASSIGNED      代表离职归档时批量解除（/api/representatives/[id]）
  // ⚠️ 它【不是】由 CustomerRepTag(MANAGING) 或机构/站点绑定派生的——生效代表解析已改为
  // SITE_BINDING > ORG_BINDING > NONE，不再读取 ownerUserId/assignmentStatus（见
  // customer-effective-representative.ts）。syncCustomerRepresentativeLinks 只回写 ownerUserId
  // 缓存与 Project/Order.representativeId，【从不】写 assignmentStatus。设计文档的简化口径
  // 「ASSIGNED=有 MANAGING 标注且有机构绑定」只是近似：派单时确实同时建 MANAGING tag，但本字段
  // 额外承载 RECALL_CANDIDATE/RECALLED 等回收生命周期子态，二者并非严格等价。
  // ⚠️ 耦合点：syncEffectiveRepresentativeLinksForOrganization（customer-representative-sync.ts）
  // 虽【不写】本字段，但【读】它作为过滤条件（{ assignmentStatus: { not: "ASSIGNED" } }）——org 级
  // 批量同步会跳过 ASSIGNED 客户。因此代表离职归档（/api/representatives/[id] PATCH）必须先把该代表
  // 名下 ASSIGNED 客户解除为 UNASSIGNED，再调 sync，否则这些客户的 Project/Order.representativeId
  // 不会被重算而残留离职代表快照。这是"读但不写"的单向耦合，改本字段语义前需同步检查 sync 的过滤逻辑。
  assignmentStatus          String                     @default("ASSIGNED") // UNASSIGNED | ASSIGNED | RECALL_CANDIDATE | RECALLED
  assignedAt                DateTime?
  assignedByUserId          String?
  assignedByUser            User?                      @relation("CrmAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  recalledAt                DateTime?
  recalledByUserId          String?
  recalledByUser            User?                      @relation("CrmRecalledByUser", fields: [recalledByUserId], references: [id], onDelete: SetNull)
  reflowReason              String?
  personCategory            String? // STUDENT, POSTDOC, RESEARCHER, PI, TECHNICIAN, CLINICIAN, ADMIN, PROCUREMENT, OTHER
  jobTitle                  String?
  graduationDate            DateTime?
  graduationReminderAt      DateTime?
  archived                  Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  interactions              CrmInteraction[]
  followUpTasks             CrmFollowUpTask[]
  addresses                 CrmCustomerAddress[]
  visitCheckins             CrmVisitCheckin[]
  applications              CrmCustomerApplication[]   @relation("CrmApplicationsCreatedProfile")
  assignmentLogs            CrmCustomerAssignmentLog[]
  orgTextDriftTasks         CustomerOrgTextDriftTask[]
  preferences               CrmCustomerPreference[]
  complaints                CrmComplaint[]
  // 客户常用称呼/历史姓名变体（docs/customer-name-alias-merge-dedup-fix-2026-07-13.md）
  nameAliases               CrmCustomerNameAlias[]

  // ── Phase C 扩表：Customer FK 家族的 profileId 反向关系（docs/customer-profile-master-migration-2026-06-29.md）──
  // 命名均带 Profile 后缀以区分既有 CRM 关系，避免与上方字段/其他 relation 名冲突。
  profileProjects            Project[]                     @relation("ProfileProjects")
  profileExternalOrders      ExternalOrder[]               @relation("ProfileExternalOrders")
  profileOrders              Order[]                       @relation("ProfileOrders")
  profileOrderDrafts         OrderDraft[]                  @relation("ProfileOrderDrafts")
  profileFinanceReceipts     FinanceReceipt[]              @relation("ProfileFinanceReceipts")
  profileFinanceAdvances     FinanceAdvance[]              @relation("FinanceAdvanceProfile")
  profileFinanceCosts        FinanceCost[]                 @relation("ProfileFinanceCosts")
  profileCostEntries         CostEntry[]                   @relation("ProfileCostEntries")
  profileRepTags             CustomerRepTag[]              @relation("CustomerRepTagProfile")
  profileReportLines         CrmRepresentativeReportLine[] @relation("ReportLineProfile")
  relationsFromProfile       CustomerRelation[]            @relation("RelationsFromProfile")
  relationsToProfile         CustomerRelation[]            @relation("RelationsToProfile")
  mergeLogsAsSourceProfile   CustomerMergeLog[]            @relation("MergeLogSourceProfile")
  mergeLogsAsTargetProfile   CustomerMergeLog[]            @relation("MergeLogTargetProfile")
  mergeTasksAsProfileA       CustomerMergeTask[]           @relation("MergeTasksAsProfileA")
  mergeTasksAsProfileB       CustomerMergeTask[]           @relation("MergeTasksAsProfileB")
  profileOrgBindingTasks     CustomerOrgBindingTask[]      @relation("OrgBindingTasksProfile")
  importRowsSuggestedProfile OrderImportRow[]              @relation("ImportRowSuggestedProfile")
  importRowsConfirmedProfile OrderImportRow[]              @relation("ImportRowConfirmedProfile")

  @@index([ownerUserId])
  @@index([stage])
  @@index([namePinyin])
  @@index([nextFollowUpAt])
  @@index([assignmentStatus])
  @@index([personCategory])
  @@index([graduationDate])
  // 主权字段迁移新增索引
  @@index([organizationId])
  @@index([organizationSiteId])
  // Phase C 生命周期字段索引
  @@index([deleted])
  @@index([mergedIntoProfileId])
}

/// 客户常用称呼 / 历史姓名变体（docs/customer-name-alias-merge-dedup-fix-2026-07-13.md）
/// 挂在 CrmCustomerProfile（姓名主权表），用于合并后旧姓名沉淀、代表申请查重、
/// 搜索召回、订单导入分级匹配和后台去重扫描。
/// aliasType: COMMON（人工常用称呼）| FORMER_NAME（曾用名）| MERGED_NAME（合并沉淀姓名）
/// sourceType: MANUAL | CUSTOMER_MERGE | IMPORT
model CrmCustomerNameAlias {
  id               String             @id @default(cuid())
  profileId        String
  profile          CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  alias            String
  normalizedAlias  String
  aliasType        String             @default("COMMON") // COMMON | FORMER_NAME | MERGED_NAME
  sourceType       String             @default("MANUAL") // MANUAL | CUSTOMER_MERGE | IMPORT
  sourceMergeLogId String?
  sourceMergeLog   CustomerMergeLog?  @relation(fields: [sourceMergeLogId], references: [id], onDelete: SetNull)
  active           Boolean            @default(true)
  createdById      String?
  createdBy        User?              @relation("CustomerNameAliasesCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([profileId, normalizedAlias])
  @@index([normalizedAlias, active])
  @@index([sourceMergeLogId])
}

/// 客户-代表关系标注（治理 P8/D5）。
/// MANAGING：正在管理（一个客户可多条多代表协作，isPrimary 标主管理代表）。
/// FOLLOWED：曾经跟进（历史记录，endedAt 标结束）。
model CustomerRepTag {
  id               String             @id @default(cuid())
  // Phase E contract：Customer 锚点列已删除，profileId 为必填唯一键主体。
  profileId        String
  profile          CrmCustomerProfile @relation("CustomerRepTagProfile", fields: [profileId], references: [id], onDelete: Cascade)
  representativeId String
  representative   Representative     @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  tagType          String // MANAGING | FOLLOWED
  isActive         Boolean            @default(true)
  startedAt        DateTime           @default(now())
  endedAt          DateTime?
  isPrimary        Boolean            @default(false) // MANAGING 时标主次
  note             String?
  source           String             @default("MANUAL") // MANUAL | HANDOVER | IMPORT | ASSIGNMENT_MIGRATION
  createdByUserId  String
  createdBy        User               @relation("CustomerRepTagsCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())

  @@unique([profileId, representativeId, tagType])
  @@index([representativeId, tagType])
  @@index([profileId, tagType, isActive])
}

model CrmCustomerAddress {
  id               String             @id @default(cuid())
  profile          CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  label            String             @default("默认")
  addressText      String?
  province         String?
  city             String?
  district         String?
  lat              Float?
  lng              Float?
  accuracy         Float?
  sourceType       String             @default("MANUAL") // MANUAL, PROJECT_IMPORT, EXTERNAL_ORDER_IMPORT, VISIT_CHECKIN
  isPrimary        Boolean            @default(false)
  verifiedAt       DateTime?
  verifiedByUserId String?
  verifiedByUser   User?              @relation("CrmAddressVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([profileId])
}

model CrmInteraction {
  id               String             @id @default(cuid())
  departmentSnapshot String           @default("FIELD_SALES") // 不可变部门归属快照（设计 §4.2）
  profile          CrmCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  type             String // CALL, WECHAT, EMAIL, MEETING, VISIT, REFERRAL, NOTE
  summary          String
  detail           String?
  happenedAt       DateTime           @default(now())
  nextActionAt     DateTime?
  relatedProjectId String?
  sourceType       String? // MANUAL | CUSTOMER_APPLICATION | CHECKIN（来源审计，不作为 KPI 类型过滤）
  sourceId         String? // 来源业务记录 ID，例如 CrmCustomerApplication.id
  createdByUserId  String
  createdByUser    User               @relation("CrmInteractionsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  voiceUrl         String?
  transcript       String?
  summaryTitle     String?
  summaryNote      String?
  asrStatus        String             @default("NONE") // NONE | UPLOADED | TRANSCRIBING | DONE | FAILED
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  complaints CrmComplaint[] @relation("CrmComplaintInteraction")

  @@index([profileId, happenedAt])
  @@index([sourceType, sourceId])
  @@index([asrStatus])
  @@index([departmentSnapshot])
}

model CrmFollowUpTask {
