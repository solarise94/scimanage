{
  "name": "project-manage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/generate-schema-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "check:profile-id-boundary": "tsx scripts/check-profile-id-boundary.ts",
    "check:agent-boundaries": "tsx scripts/check-agent-boundaries.ts",
    "governance:technical-owner:dry-run": "tsx scripts/backfill-technical-owner-governance.ts --dry-run",
    "governance:technical-owner:apply": "tsx scripts/backfill-technical-owner-governance.ts --apply",
    "expand:profile-fks:precheck": "tsx scripts/expand-profile-fks.ts --precheck",
    "expand:profile-fks:backfill": "tsx scripts/expand-profile-fks.ts --backfill",
    "expand:profile-fks:verify": "tsx scripts/expand-profile-fks.ts --verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck:app && npm run typecheck:scripts && npm run check:profile-id-boundary && npm run check:agent-boundaries && npm run test",
    "agent-runtime:dev": "npm --prefix agent-runtime run dev",
    "agent-runtime:build": "npm --prefix agent-runtime run build",
    "agent-runtime:start": "npm --prefix agent-runtime run start",
    "prepare": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-virtual": "^3.14.3",
    "@types/d3-force": "^3.0.10",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "docxtemplater": "^3.69.0",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.7.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.40.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pinyin-match": "^1.2.10",
    "pinyin-pro": "^3.28.1",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
