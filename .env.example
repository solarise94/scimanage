# =============================================================================
# SciManage — 环境变量模板
# =============================================================================
# 用法：cp .env.example .env，然后填入真实值。.env 被 .gitignore 忽略，绝不入库。
# 容器部署：docker compose 默认读取仓库根 .env（见 docker-compose.yml）。
# =============================================================================

# ── 基础（本地开发与容器部署都需要）──────────────────────────────────────────
# NextAuth JWT 签名密钥（必填）。生成：openssl rand -base64 32
NEXTAUTH_SECRET=
# 对外访问地址。本地开发默认 http://localhost:3000；生产填经反代后的 https 域名。
NEXTAUTH_URL=http://localhost:3000
# SQLite 数据库路径。本地开发默认 file:/app/prisma/dev.db；容器内默认 file:/data/dev.db
DATABASE_URL=file:/app/prisma/dev.db
# Web 端口（容器内固定 3000；本地 next dev 默认 3000）
PORT=3000

# ── 门户 / 部门隔离（双门户）────────────────────────────────────────────────
# FIELD_SALES（销售门户，默认）或 ONLINE_OPS（线上运营门户）
PORTAL_CODE=FIELD_SALES
# 门户显示名（可选，覆盖默认）
PORTAL_DISPLAY_NAME=

# ── AI / Agent 工作台 ────────────────────────────────────────────────────────
# MiniMax 模型 API key（启用 AI Agent 工作台必填）
MINIMAX_API_KEY=
# MiniMax base URL 与模型（默认值如下，一般无需改）
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# Agent runtime sidecar（容器内固定值；本地开发时 next app 与 sidecar 同进程约定）
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=3001
AGENT_RUNTIME_URL=http://127.0.0.1:3001
# sidecar 与主 app 之间的共享 token（生产建议设置）
AGENT_RUNTIME_TOKEN=
# 推理思考级别（off/minimal/low/high/xhigh，留空走模型默认）
AGENT_RUNTIME_THINKING_LEVEL=
AGENT_CONTEXT_WINDOW_TOKENS=1000000

# Agent 能力开关（默认均按代码内置值；按需显式覆盖）
AGENT_GENUI_ENABLED=
AGENT_DESKTOP_ENABLED=
AGENT_MOBILE_ENABLED=
AGENT_MEMORY_ENABLED=
AGENT_PROACTIVE_ENABLED=
AGENT_WEB_SEARCH_ENABLED=
AGENT_VIEW_CONTROL_ENABLED=
AGENT_JOB_WORKER_ENABLED=
AGENT_PROJECT_INVOICE_PLANNING_ENABLED=
AGENT_DYNAMIC_TOOL_BUNDLES_ENABLED=
AGENT_COMPACTION_ENABLED=
AGENT_COMPACTION_KEEP_RECENT_TOKENS=
AGENT_COMPACTION_TRIGGER_TOKENS=

# 向量召回 / 记忆（可选，夜间整理 + 召回增强；未配置时优雅降级）
AGENT_VECTOR_BASE_URL=http://127.0.0.1:8103
AGENT_VECTOR_API_KEY=
AGENT_EMBED_MODEL=BAAI/bge-m3
AGENT_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Agent 工作区 / 暂存目录（容器内默认 /data 下；本地默认仓库内隐藏目录）
AGENT_WORKSPACE_DIR=
AGENT_PROJECT_ATTACHMENT_DIR=
AGENT_ATTACHMENT_STAGING_DIR=
INVOICE_STAGING_DIR=
IMPORT_STAGING_DIR=
DRAFT_MEDIA_DIR=
SCIMANAGE_CONTRACT_UPLOADS_DIR=

# 内部 cron token（可选，定时任务鉴权；不设则跳过对应循环）
REMINDER_CRON_TOKEN=
AGENT_DREAM_CRON_TOKEN=
CRM_LIFECYCLE_CRON_TOKEN=
CRM_REVIEW_CRON_TOKEN=
DEPLOY_NOTIFY_TOKEN=
AGENT_INTERNAL_APP_URL=
AGENT_INTERNAL_TOOL_TOKEN=
PORTAL_RUN_SCHEDULED_JOBS=

# ── 第三方服务（均可选，未配置时对应能力降级/隐藏）──────────────────────────
# 腾讯云 ASR（语音识别默认链；TENCENTCLOUD_SECRET_ID/KEY 配齐即启用）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 本地 / 自建 ASR（asr-fast，默认不进入链路）
ASR_LOCAL_BASE_URL=http://127.0.0.1:8102
ASR_LOCAL_API_KEY=
ASR_LOCAL_TIMEOUT_MS=
# 智谱 OCR（回单预填，可选）
ZHIPU_API_KEY=
ZHIPU_API_BASE=
# Tavily（Agent 联网搜索，可选）
TAVILY_API_KEY=
# 高德地图（CRM 拜访地图，可选）
AMAP_WEB_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# 邮件（SMTP；通知/Magic Link 需要）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── CRM 杂项 ─────────────────────────────────────────────────────────────────
CRM_VISIT_PHOTO_MAX_MB=
CUSTOMER_MERGE_REVERSE_WINDOW_DAYS=

# ── 首次 seed（仅容器首次启动 dev.db 新建时执行）──────────────────────────────
SEED_ON_FIRST_BOOT=true
ADMIN_SEED_PASSWORD=
SEED_USER1_PASSWORD=
SEED_USER2_PASSWORD=

# ── 构建期（一般不由 .env 提供，供 docker build --build-arg 用）────────────────
APP_BUILD_VERSION=
